  {
    "name": "Offers & discounts",
    "settings": [
      {
        "type": "paragraph",
        "content": "Change offer percentages here: banners, product bundle prices and cart messages update across the store instantly. Then set the same % in Shopify admin → Discounts (the 4 automatic Zeyov discounts) so checkout charges match."
      },
      {
        "type": "header",
        "content": "Cart offer (total items in cart)"
      },
      {
        "type": "number",
        "id": "tier1_qty",
        "label": "Tier 1 – minimum items",
        "default": 3
      },
      {
        "type": "number",
        "id": "tier1_pct",
        "label": "Tier 1 – % off",
        "default": 3
      },
      {
        "type": "number",
        "id": "tier2_qty",
        "label": "Tier 2 – minimum items",
        "default": 5
      },
      {
        "type": "number",
        "id": "tier2_pct",
        "label": "Tier 2 – % off",
        "default": 5
      },
      {
        "type": "header",
        "content": "Bundle offer (same product quantity)"
      },
      {
        "type": "number",
        "id": "bundle2_pct",
        "label": "2 pieces – % off",
        "default": 5
      },
      {
        "type": "number",
        "id": "bundle3_pct",
        "label": "3+ pieces – % off",
        "default": 10
      }
    ]
  },
