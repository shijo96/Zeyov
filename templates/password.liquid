{% layout 'password' %}
<div style="min-height:100vh;display:grid;place-items:center;background:url({{ 'zeyov-brand.jpg' | asset_url }}) center/cover">
  <div class="form" style="background:rgba(251,246,238,.92);border-radius:22px;padding:32px 24px;margin:16px;backdrop-filter:blur(10px)">
    <h1>Launching soon</h1>
    <p class="muted" style="text-align:center">{{ shop.password_message | default: 'Own-brand tees. Style for a brighter you.' }}</p>
    {% form 'customer' %}{% if form.posted_successfully? %}<p class="notice">We'll email you when we open.</p>{% else %}<input type="hidden" name="contact[tags]" value="prospect,password page"><input class="input" type="email" name="contact[email]" placeholder="Email for launch alert" required><button class="btn btn--block" style="margin-top:10px">Notify me</button>{% endif %}{% endform %}
    <details><summary class="muted" style="cursor:pointer;text-align:center">Store owner? Enter password</summary>
      {% form 'storefront_password' %}{{ form.errors | default_errors }}<input class="input" type="password" name="password" placeholder="Password" style="margin-top:10px"><button class="btn btn--block" style="margin-top:10px">Enter</button>{% endform %}
    </details>
  </div>
</div>
