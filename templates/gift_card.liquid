{% layout none %}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Gift card – {{ shop.name }}</title>{{ 'base.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head>
<body style="padding:0"><div class="form" style="text-align:center"><span class="wordmark" style="justify-content:center">Zeyov</span><h1>{{ gift_card.balance | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</h1><p class="muted">Gift card code</p><p style="font:600 22px/1 var(--font-body);letter-spacing:.12em">{{ gift_card.code | format_code }}</p>{% if gift_card.expires_on %}<p class="muted">Expires {{ gift_card.expires_on | date: '%d %b %Y' }}</p>{% endif %}<a class="btn" href="{{ shop.url }}">Shop now</a></div></body></html>
