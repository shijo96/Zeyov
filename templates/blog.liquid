<div class="wrap"><div class="page-narrow"><h1>{{ blog.title }}</h1>{% paginate blog.articles by 12 %}{% for article in blog.articles %}<article style="padding-block:14px;border-bottom:1px solid var(--line)"><h2 style="font-size:24px"><a href="{{ article.url }}">{{ article.title }}</a></h2><p class="muted">{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p></article>{% endfor %}{% endpaginate %}</div></div>
