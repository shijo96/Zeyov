{%- comment -%}
  ZEYOV 404 & Dynamic Page Fallback Router
  Intercepts missing policy/help pages and renders them seamlessly without 404.
{%- endcomment -%}

<div id="Zeyov404Wrapper">
  <!-- Default 404 Content (hidden if auto-routed to a policy/help page) -->
  <div id="Zeyov404Default">
    {% render 'page-404-content' %}
  </div>

  <!-- Dynamic Fallback Page Sections (pre-rendered with luxury atelier content) -->
  <div id="FallbackShipping" class="zeyov-fallback-page" style="display:none;">
    {% render 'page-shipping-content' %}
  </div>

  <div id="FallbackRefund" class="zeyov-fallback-page" style="display:none;">
    {% render 'page-refund-content' %}
  </div>

  <div id="FallbackPrivacy" class="zeyov-fallback-page" style="display:none;">
    {% render 'page-privacy-content' %}
  </div>

  <div id="FallbackTerms" class="zeyov-fallback-page" style="display:none;">
    {% render 'page-terms-content' %}
  </div>

  <div id="FallbackTrack" class="zeyov-fallback-page" style="display:none;">
    {% render 'page-track-order-content' %}
  </div>

  <div id="FallbackAbout" class="zeyov-fallback-page" style="display:none;">
    {% render 'page-about-content' %}
  </div>

  <div id="FallbackContact" class="zeyov-fallback-page" style="display:none;">
    {% render 'page-contact-content' %}
  </div>

  <div id="FallbackFaq" class="zeyov-fallback-page" style="display:none;">
    {% render 'page-faq-content' %}
  </div>

  <!-- Dynamic Collection Fallback (zero 404 for any fashion collection URL) -->
  <div id="FallbackCollection" class="zeyov-fallback-page" style="display:none;">
    {% render 'page-collection-fallback' %}
  </div>
</div>

