        if (desc) desc.textContent = item.desc;
        var ac = document.getElementById('FallbackActiveChip');
        if (ac) ac.textContent = item.title;

        var pillsWrap = document.getElementById('FallbackColPills');
        if (pillsWrap && item.pills && item.pills.length) {
          pillsWrap.innerHTML = '';
          for (var i = 0; i < item.pills.length; i++) {
            var a = document.createElement('a');
            a.className = 'cat-pill';
            a.href = item.pills[i].u;
            a.textContent = item.pills[i].t;
            pillsWrap.appendChild(a);
          }
        }

        var waBtn = document.getElementById('FallbackWaBtn');
        if (waBtn) {
          var baseWa = waBtn.getAttribute('href') || '';
          var phoneMatch = baseWa.match(/wa\.me\/([0-9]+)/);
          if (phoneMatch && phoneMatch[1]) {
            waBtn.href = 'https://wa.me/' + phoneMatch[1] + '?text=' + encodeURIComponent('Hi Zeyov Atelier, I want to inquire about the ' + item.title + ' collection.');
          }
        }
      } else if (p.indexOf('shipping') !== -1 || p.indexOf('delivery') !== -1) {
        matchedId = 'FallbackShipping';
        document.title = 'Shipping & Delivery Policy – ZEYOV';
      } else if (p.indexOf('refund') !== -1 || p.indexOf('return') !== -1) {
        matchedId = 'FallbackRefund';
        document.title = 'Return & Refund Policy – ZEYOV';
      } else if (p.indexOf('privacy') !== -1) {
        matchedId = 'FallbackPrivacy';
        document.title = 'Privacy Policy – ZEYOV';
      } else if (p.indexOf('term') !== -1) {
        matchedId = 'FallbackTerms';
        document.title = 'Terms of Service – ZEYOV';
      } else if (p.indexOf('track') !== -1) {
        matchedId = 'FallbackTrack';
        document.title = 'Track Your Order – ZEYOV';
      } else if (p.indexOf('about') !== -1) {
        matchedId = 'FallbackAbout';
        document.title = 'About ZEYOV – Luxury Atelier';
      } else if (p.indexOf('contact') !== -1) {
        matchedId = 'FallbackContact';
        document.title = 'Contact Us – ZEYOV Concierge';
      } else if (p.indexOf('faq') !== -1 || p.indexOf('question') !== -1) {
        matchedId = 'FallbackFaq';
        document.title = 'Frequently Asked Questions – ZEYOV';
      }

      if (matchedId) {
        var target = document.getElementById(matchedId);
        if (target) {
          if (def) def.style.display = 'none';
          target.style.display = 'block';
        }
      }
    } catch (e) {}
  })();
</script>
