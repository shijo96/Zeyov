<section class="section">
  <div class="container container--tiny">
    <h1 class="center">Reset password</h1>
    {%- form 'reset_customer_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <label>New password (min. 8 characters)<input type="password" name="customer[password]" autocomplete="new-password" minlength="8" maxlength="100" required></label>
      <label>Confirm password<input type="password" name="customer[password_confirmation]" autocomplete="new-password" minlength="8" maxlength="100" required></label>
      <button class="btn btn--block" type="submit">Reset password</button>
    {%- endform -%}
  </div>
</section>
