<div class="wrap"><div class="page-narrow">
  <span class="eyebrow">Account</span>
  <h1>Hi {{ customer.first_name | default: 'there' }}</h1>
  <p><a href="{{ routes.account_logout_url }}" class="remove">Log out</a> · <a class="remove" href="{{ routes.account_addresses_url }}">Addresses ({{ customer.addresses_count }})</a></p>
  <h2 style="font-size:24px;margin-top:20px">Orders</h2>
  {% paginate customer.orders by 20 %}
    {% for order in customer.orders %}
      <div class="line" style="grid-template-columns:1fr auto"><div><a href="{{ order.customer_url }}"><b>{{ order.name }}</b></a><div class="muted" style="font-size:13px">{{ order.created_at | date: '%d %b %Y' }} · {{ order.fulfillment_status_label }}</div></div><b>{{ order.total_price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</b></div>
    {% else %}<p class="muted">No orders yet.</p>{% endfor %}
  {% endpaginate %}
</div></div>
