<div class="wrap"><div class="form"><h1>Activate account</h1>{% form 'activate_customer_password' %}{{ form.errors | default_errors }}<input class="input" type="password" name="customer[password]" placeholder="Password" required><input class="input" type="password" name="customer[password_confirmation]" placeholder="Confirm password" required style="margin-top:10px"><button class="btn btn--block" style="margin-top:10px">Activate</button>{% endform %}</div></div>
