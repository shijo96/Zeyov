{%- comment -%}
  ZEYOV — Personalized Recommendations & Recently Viewed Engine
  Displays dynamic personalized picks based on customer browsing history and affinity.
{%- endcomment -%}
<section class="section section--tint personalized-recs" id="PersonalizedRecsSection" style="display: none;" data-personalized-recs>
  <div class="container">
    <header class="section__head center">
      <p class="eyebrow">CURATED FOR YOU</p>
      <h2>Recently Viewed &amp; Recommended</h2>
      <p class="muted small">Silhouettes tailored to your style preferences.</p>
    </header>

    <div class="personalized-recs__grid" id="PersonalizedRecsGrid">
      <!-- Populated dynamically via theme.js browsing history -->
    </div>
  </div>
</section>
