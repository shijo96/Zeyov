{%- comment -%}
  ZEYOV Dynamic Collection Fallback Router Snippet
  Seamlessly renders requested fashion collections when not yet registered in Shopify database.
  Provides full breadcrumbs, department pills, facet filters, product grid, and WhatsApp styling concierge.
{%- endcomment -%}

<section class="section collection-page zeyov-dynamic-collection-view" id="DynamicCollectionView">
  <div class="container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Collections</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="cur" id="FallbackColCrumb" aria-current="page">Curated Collection</span>
    </nav>

    <!-- Myntra-Style Department Tab Switcher (ALL | WOMEN | MEN | KIDS) -->
    <div class="myntra-dept-tabs" role="tablist" aria-label="Department Selection">
      <a href="{{ routes.all_products_collection_url }}" class="dept-tab is-active" id="FallbackTabAll" role="tab">
        <span>ALL</span>
      </a>
      <a href="{{ routes.collections_url }}/womens-wear" class="dept-tab" id="FallbackTabWomen" role="tab">
        <span>WOMEN</span>
      </a>
      <a href="{{ routes.collections_url }}/mens-wear" class="dept-tab" id="FallbackTabMen" role="tab">
        <span>MEN</span>
      </a>
      <a href="{{ routes.collections_url }}/kidswear" class="dept-tab" id="FallbackTabKids" role="tab">
        <span>KIDS</span>
      </a>
    </div>

    <!-- Myntra-Style Visual Micro-Categories Horizontal Track (Thumbnails + Names) -->
    <div class="myntra-circle-rail-wrap">
      <div class="myntra-circle-rail" id="FallbackCircleRail">
        <a href="{{ routes.collections_url }}/womens-wear" class="circle-item">
          <div class="circle-item__bubble">
            <img src="{{ 'fashion-silk-dress.jpg' | asset_url }}" alt="All Women" width="68" height="68" loading="eager">
          </div>
          <span class="circle-item__label">All Women</span>
        </a>
        <a href="{{ routes.collections_url }}/womens-dresses" class="circle-item">
          <div class="circle-item__bubble">
            <img src="{{ 'cat-coords.jpg' | asset_url }}" alt="Dresses" width="68" height="68" loading="eager">
          </div>
          <span class="circle-item__label">Dresses</span>
        </a>
        <a href="{{ routes.collections_url }}/western-wear" class="circle-item">
          <div class="circle-item__bubble">
            <img src="{{ 'collection-runway.jpg' | asset_url }}" alt="Western" width="68" height="68" loading="eager">
          </div>
          <span class="circle-item__label">Western</span>
        </a>
        <a href="{{ routes.collections_url }}/womens-tops-tshirts" class="circle-item">
          <div class="circle-item__bubble">
            <img src="{{ 'cat-festive.jpg' | asset_url }}" alt="Tops & Tees" width="68" height="68" loading="eager">
          </div>
          <span class="circle-item__label">Tops &amp; Tees</span>
        </a>
        <a href="{{ routes.collections_url }}/womens-bottomwear" class="circle-item">
          <div class="circle-item__bubble">
            <img src="{{ 'fashion-wool-coat.jpg' | asset_url }}" alt="Bottomwear" width="68" height="68" loading="eager">
          </div>
          <span class="circle-item__label">Bottomwear</span>
        </a>
        <a href="{{ routes.collections_url }}/womens-winter-wear" class="circle-item">
          <div class="circle-item__bubble">
            <img src="{{ 'fashion-sherpa-jacket.jpg' | asset_url }}" alt="Winter Wear" width="68" height="68" loading="eager">
          </div>
          <span class="circle-item__label">Winter Wear</span>
        </a>
        <a href="{{ routes.collections_url }}/accessories" class="circle-item">
          <div class="circle-item__bubble">
            <img src="{{ 'cat-accessories.jpg' | asset_url }}" alt="Accessories" width="68" height="68" loading="eager">
          </div>
          <span class="circle-item__label">Accessories</span>
        </a>
        <a href="{{ routes.collections_url }}/new-arrivals" class="circle-item">
          <div class="circle-item__bubble">
            <img src="{{ 'fashion-model-dress.jpg' | asset_url }}" alt="New In" width="68" height="68" loading="eager">
          </div>
          <span class="circle-item__label">New In</span>
        </a>
      </div>
    </div>

    <!-- Collection Editorial Header (Clean & Compact on Mobile) -->
    <header class="section__head collection-head">
      <div class="collection-title-row">
        <h1 class="collection-title">
          <span id="FallbackColTitle">Luxury Fashion Collection</span>
          <span class="title-count">(Curated pieces)</span>
        </h1>
      </div>
      <div class="collection-desc rte muted desktop-only">
        <p id="FallbackColDesc">Discover precision-tailored garments, sculpted silhouettes, and handcrafted luxury accessories designed for modern distinction.</p>
      </div>

      <!-- Horizontal Scrollable Category Capsule Pills (Never Wraps on Mobile) -->
      <div class="collection-nav-pills" id="FallbackColPills" role="navigation" aria-label="Collection Categories">
        <a href="{{ routes.collections_url }}/new-arrivals" class="cat-pill">New Arrivals</a>
        <a href="{{ routes.collections_url }}/womens-wear" class="cat-pill">Women's Wear</a>
        <a href="{{ routes.collections_url }}/mens-wear" class="cat-pill">Men's Wear</a>
        <a href="{{ routes.collections_url }}/accessories" class="cat-pill">Accessories</a>
        <a href="{{ routes.collections_url }}/western-wear" class="cat-pill">Western Wear</a>
        <a href="{{ routes.collections_url }}/womens-dresses" class="cat-pill">Dresses &amp; Gowns</a>
        <a href="{{ routes.collections_url }}/womens-tops-tshirts" class="cat-pill">Tops &amp; Tees</a>
        <a href="{{ routes.collections_url }}/womens-bottomwear" class="cat-pill">Bottomwear</a>
        <a href="{{ routes.collections_url }}/kidswear" class="cat-pill">Kidswear</a>
        <a href="{{ routes.all_products_collection_url }}" class="cat-pill">All Creations</a>
      </div>
    </header>

    <!-- Collection Toolbar -->
    <div class="collection-toolbar">
      <div class="toolbar__count">
        <span class="toolbar__count-num">Curated</span>
        <span class="toolbar__count-text">Pieces Available</span>
      </div>

      <div class="toolbar__sort-wrap">
        <label for="FallbackSort" class="sort-label">Sort By</label>
        <div class="sort-select-box">
          <select id="FallbackSort" class="sort-select">
            <option value="featured">Featured Runway</option>
            <option value="best-selling">Best Selling</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
            <option value="newest">Newest Additions</option>
          </select>
          <span class="sort-chevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </span>
        </div>
      </div>
    </div>

    <!-- Collection Facet Filters Bar -->
    <div class="collection-facets-wrap">
      <div class="facets__header">
        <h3 class="facets__title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
          Refine &amp; Filter
        </h3>
        <div class="facets__summary-bar">
          <span>Premium Curation Active</span>
        </div>
      </div>
      <div class="active-filters" style="border:none;margin:0;padding-top:14px">
        <span class="active-filter-chip" style="background:var(--gold-dark);color:#fff" id="FallbackActiveChip">
          All Pieces
        </span>
        <a href="{{ routes.collections_url }}/new-arrivals" class="active-filter-chip">New Arrivals</a>
        <a href="{{ routes.collections_url }}/womens-wear" class="active-filter-chip">Women's Wear</a>
        <a href="{{ routes.collections_url }}/mens-wear" class="active-filter-chip">Men's Wear</a>
        <a href="{{ routes.collections_url }}/accessories" class="active-filter-chip">Accessories</a>
        <a href="{{ routes.collections_url }}/western-wear" class="active-filter-chip">Western Wear</a>
        <a href="{{ routes.collections_url }}/womens-dresses" class="active-filter-chip">Dresses</a>
        <a href="{{ routes.collections_url }}/womens-tops-tshirts" class="active-filter-chip">Tops &amp; Tees</a>
        <a href="{{ routes.collections_url }}/kidswear" class="active-filter-chip">Kidswear</a>
      </div>
    </div>

    <!-- Product Grid (Uniform 4-Cards Desktop / 2-Cards Mobile) -->
    <div class="grid grid--products grid--fashion-catalog" id="FallbackProductGrid">
      {%- assign all_prods = collections.all.products -%}
      {%- if all_prods.size > 0 -%}
        {%- for prod in all_prods limit: 8 -%}
          {% render 'product-card', product: prod %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- WhatsApp Concierge Support Box -->
    {%- if settings.whatsapp_number != blank -%}
      {%- assign wa_num = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' -%}
      <div class="collection-concierge-box" style="margin-top:40px;background:linear-gradient(135deg, #fffaf2 0%, #fdf8f0 100%);border:1px solid var(--line);border-radius:14px;padding:28px 24px;text-align:center;">
        <span class="badge badge--gold mb-xs">STYLING CONCIERGE</span>
        <h3 style="font-family:var(--font-heading);font-size:1.3rem;margin:6px 0 8px;">Inquire About This Collection</h3>
        <p class="muted" style="max-width:540px;margin:0 auto 18px;font-size:0.9rem;">
          Looking for a custom size, fabric swatches, or express delivery for an upcoming celebration? Chat directly with our senior styling concierge.
        </p>
        <a id="FallbackWaBtn" class="btn btn--gold" href="https://wa.me/{{ wa_num }}?text=Hi%20Zeyov%20Atelier%2C%20I%20am%20exploring%20your%20collection" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:8px;">
          {% render 'icon', name: 'whatsapp' %} Inquire on WhatsApp
        </a>
      </div>
    {%- endif -%}
  </div>

  <!-- Floating Sticky Action Bar (Myntra App Style: ⇅ SORT | ⊶ FILTER) -->
  <div class="collection-floating-bar" id="FallbackFloatingBar">
    <button type="button" class="floating-bar-btn" data-open-sort-sheet aria-label="Sort collection">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg>
      <span>SORT</span>
    </button>
    <span class="floating-bar-sep" aria-hidden="true"></span>
    <button type="button" class="floating-bar-btn" data-open-filters aria-label="Filter collection">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
      <span>FILTER</span>
    </button>
  </div>

  <!-- Mobile Sort Bottom Sheet (Myntra Style) -->
  <div class="sort-sheet-backdrop" id="SortSheetBackdropFallback" data-close-sort-sheet hidden></div>
  <div class="sort-bottom-sheet" id="SortBottomSheetFallback" aria-hidden="true">
    <div class="sort-sheet__header">
      <span class="sort-sheet__title">SORT BY</span>
      <button type="button" class="icon-btn sort-sheet__close" data-close-sort-sheet aria-label="Close sort sheet">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <ul class="sort-sheet__list" role="list">
      <li class="sort-sheet__item is-active" data-sort="manual">
        <span>Featured Runway</span>
        <span class="sort-sheet__radio"></span>
      </li>
      <li class="sort-sheet__item" data-sort="best-selling">
        <span>Best Selling</span>
        <span class="sort-sheet__radio"></span>
      </li>
      <li class="sort-sheet__item" data-sort="price-ascending">
        <span>Price: Low to High</span>
        <span class="sort-sheet__radio"></span>
      </li>
      <li class="sort-sheet__item" data-sort="price-descending">
        <span>Price: High to Low</span>
        <span class="sort-sheet__radio"></span>
      </li>
      <li class="sort-sheet__item" data-sort="created-descending">
        <span>Newest Additions</span>
        <span class="sort-sheet__radio"></span>
      </li>
    </ul>
  </div>
</section>
