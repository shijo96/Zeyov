<section class="section policy-page">
  <div class="container container--narrow">
    <header class="section__head center">
      <p class="eyebrow">Customer Protection</p>
      <h1>Return &amp; Refund Policy</h1>
      <p class="muted">Hassle-free resolutions, fair terms, and prompt customer assistance.</p>
    </header>

    <div class="policy-highlight">
      <div class="policy-highlight__card">
        <span class="policy-highlight__icon">{% render 'icon', name: 'return' %}</span>
        <div>
          <h3>7-Day Return / Replacement</h3>
          <p><strong>Simple &amp; transparent process</strong></p>
          <small class="muted">Report any defect, damage, or discrepancy within 7 days of delivery.</small>
        </div>
      </div>
      <div class="policy-highlight__card">
        <span class="policy-highlight__icon">{% render 'icon', name: 'shield' %}</span>
        <div>
          <h3>100% Genuine Quality Guarantee</h3>
          <p><strong>Peace of mind on every order</strong></p>
          <small class="muted">Pre-inspected products packed with protective transit wrapping.</small>
        </div>
      </div>
    </div>

    <div class="policy-body rte">
      {%- if shop.refund_policy.body != blank -%}
        {{ shop.refund_policy.body }}
      {%- elsif page.content != blank -%}
        {{ page.content }}
      {%- else -%}
        <h2>1. Overview</h2>
        <p>At <strong>ZEYOV</strong>, we take genuine pride in curating thoughtful, high-quality products. We want you to be completely satisfied with every order. If an item arrives defective, damaged in transit, or different from what was ordered, our customer care team is here to make it right.</p>

        <h2>2. Eligibility for Returns &amp; Replacements</h2>
        <p>To be eligible for a return or replacement:</p>
        <ul>
          <li>You must contact us within <strong>7 days of delivery</strong>.</li>
          <li>The item must be in its original condition, unused, with original packaging, tags, and all included accessories intact.</li>
          <li>Proof of purchase (Order number or confirmation email/SMS) is required.</li>
        </ul>

        <h2>3. How to Request a Return or Replacement</h2>
        <p>Initiating a request takes under 2 minutes:</p>
        <ol>
          <li>Message our support team on <strong>WhatsApp</strong> or email us at <strong><a href="mailto:{{ settings.support_email | default: 'support@zeyov.com' }}">{{ settings.support_email | default: 'support@zeyov.com' }}</a></strong> with your Order ID.</li>
          <li>Share a brief photo or short unboxing video clearly displaying the issue or defect.</li>
          <li>Our team will review your request within 24 hours and arrange a replacement shipment or pickup accordingly.</li>
        </ol>

        <h2>4. Refunds &amp; Processing Timelines</h2>
        <p>Once your returned item is received and inspected at our fulfilment center:</p>
        <ul>
          <li><strong>Prepaid Orders (Cards, Net Banking, UPI):</strong> Refunds are credited directly back to the original source within <strong>3–5 business days</strong>.</li>
          <li><strong>Cash on Delivery (COD) Orders:</strong> Refunds are disbursed securely via direct UPI transfer or NEFT bank transfer upon receiving your account details.</li>
        </ul>

        <h2>5. Cancellations</h2>
        <p>Orders can be cancelled free of charge before dispatch. Once an order has been handed over to the courier (processing complete), it cannot be cancelled in transit, but you can request an easy exchange or return upon arrival.</p>
      {%- endif -%}
    </div>

    <!-- Return / Exchange Request Assistant -->
    <div class="card-box mt" style="background:#FAF8F4;border:1.5px solid var(--border);border-radius:18px;padding:clamp(20px, 3.5vw, 30px);margin-top:32px;">
      <div style="text-align:center;max-width:540px;margin:0 auto 20px;">
        <span class="badge badge--gold mb-sm">Fast &amp; Hassle-Free</span>
        <h3 style="font-size:1.3rem;margin:6px 0 8px;">Request a Return or Exchange</h3>
        <p class="muted small">Enter your details below to initiate a return or size exchange. Our support concierge will arrange a doorstep courier pickup.</p>
      </div>

      <form id="QuickReturnForm" style="max-width:540px;margin:0 auto;" novalidate>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
          <div>
            <label for="RetOrderId" style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;margin-bottom:5px;">Order ID <span class="req-star">*</span></label>
            <input type="text" id="RetOrderId" placeholder="e.g. #1024" required style="width:100%;height:44px;border:1.5px solid var(--border);border-radius:10px;padding:0 12px;font-size:0.88rem;background:#fff;">
          </div>
          <div>
            <label for="RetPhone" style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;margin-bottom:5px;">Phone / WhatsApp <span class="req-star">*</span></label>
            <input type="text" id="RetPhone" placeholder="10-digit mobile" required style="width:100%;height:44px;border:1.5px solid var(--border);border-radius:10px;padding:0 12px;font-size:0.88rem;background:#fff;">
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
          <div>
            <label for="RetAction" style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;margin-bottom:5px;">Action Desired</label>
            <select id="RetAction" style="width:100%;height:44px;border:1.5px solid var(--border);border-radius:10px;padding:0 10px;font-size:0.86rem;background:#fff;">
              <option value="Exchange (Size / Fit Issue)">Exchange (Size / Fit Issue)</option>
              <option value="Return for Full Refund">Return for Full Refund</option>
              <option value="Replacement (Damaged Item)">Replacement (Damaged Item)</option>
            </select>
          </div>
          <div>
            <label for="RetReason" style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;margin-bottom:5px;">Primary Reason</label>
            <select id="RetReason" style="width:100%;height:44px;border:1.5px solid var(--border);border-radius:10px;padding:0 10px;font-size:0.86rem;background:#fff;">
              <option value="Size does not fit properly">Size does not fit properly</option>
              <option value="Damaged or defective on arrival">Damaged or defective on arrival</option>
              <option value="Different item received">Different item received</option>
              <option value="Fabric / Quality not as expected">Fabric / Quality not as expected</option>
            </select>
          </div>
        </div>

        <div style="margin-bottom:14px;">
          <label for="RetNote" style="display:block;font-size:0.75rem;font-weight:700;text-transform:uppercase;margin-bottom:5px;">Brief Note / Details (Optional)</label>
          <input type="text" id="RetNote" placeholder="e.g. Need Large size instead of Medium" style="width:100%;height:44px;border:1.5px solid var(--border);border-radius:10px;padding:0 12px;font-size:0.88rem;background:#fff;">
        </div>

        <button type="submit" class="btn btn--gold btn--block" style="height:46px;font-size:0.88rem;display:inline-flex;align-items:center;justify-content:center;gap:8px;">
          {% render 'icon', name: 'whatsapp' %}
          <span>Submit Return Request on WhatsApp &rarr;</span>
        </button>
        <p class="small muted center" style="margin-top:8px;font-size:0.74rem;">Takes &lt; 30 seconds. You can attach unboxing photos directly on WhatsApp.</p>
      </form>
    </div>

    <script>
      (function() {
        var f = document.getElementById('QuickReturnForm');
        if (!f) return;
        f.addEventListener('submit', function(e) {
          e.preventDefault();
          var o = (document.getElementById('RetOrderId').value || '').trim();
          var p = (document.getElementById('RetPhone').value || '').trim();
          var a = document.getElementById('RetAction').value;
          var r = document.getElementById('RetReason').value;
          var n = (document.getElementById('RetNote').value || '').trim();

          if (!o) { document.getElementById('RetOrderId').focus(); return; }
          if (!p) { document.getElementById('RetPhone').focus(); return; }

          var waPhone = '{{ settings.whatsapp_number | default: "9447873029" | replace: "+", "" | replace: " ", "" }}';
          var msg = 'Hi Zeyov Support, I would like to request a ' + a + ' for Order ' + o.toUpperCase() + '.\n' +
                    'Phone: ' + p + '\n' +
                    'Reason: ' + r + '\n' +
                    (n ? 'Note: ' + n + '\n' : '') +
                    'I am attaching the product photos for verification.';

          var url = 'https://wa.me/' + waPhone + '?text=' + encodeURIComponent(msg);
          window.open(url, '_blank', 'noopener,noreferrer');
        });
      })();
    </script>

    <div class="policy-help-box mt">
      <div class="policy-help-box__content">
        <h4>Have a question about an order?</h4>
        <p class="small muted">Chat directly with our care team on WhatsApp or send us an email.</p>
      </div>
      <div class="policy-help-box__actions">
        {%- if settings.whatsapp_number != blank -%}
          <a class="btn btn--small btn--gold" href="https://wa.me/{{ settings.whatsapp_number | replace: '+', '' | replace: ' ', '' }}?text=Hi%20Zeyov%2C%20I%20have%20a%20question%20about%20returns" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %} WhatsApp Care</a>
        {%- endif -%}
        {%- assign contact_link = pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us' -%}
        <a class="btn btn--small btn--outline" href="{{ contact_link }}">Contact Us</a>
      </div>
    </div>
  </div>
</section>
