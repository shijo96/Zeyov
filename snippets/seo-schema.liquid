{%- comment -%}
  ZEYOV Fashion Runway & Atelier - Comprehensive JSON-LD Structured Data Schema
  Compliant with Schema.org, Google Rich Results, and Online Store 2.0
{%- endcomment -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": "ZEYOV",
      "url": "{{ shop.url }}",
      "logo": {
        "@type": "ImageObject",
        "@id": "{{ shop.url }}/#logo",
        "url": "{%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 600 }}{%- else -%}{{ 'zeyov-logo.png' | asset_url }}{%- endif -%}",
        "caption": "ZEYOV Luxury Fashion Atelier"
      },
      "image": {
        "@id": "{{ shop.url }}/#logo"
      },
      "description": "ZEYOV is a premier women's fashion house and multi-brand online store in Kerala, India, curating stylish maxi dresses, cotton gowns, ethnic wear, and plus-size clothing with free delivery on prepaid orders across India.",
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+919447873029",
          "contactType": "Customer Support",
          "email": "zeyovofficial@gmail.com",
          "availableLanguage": ["en", "ml", "hi"],
          "areaServed": "IN"
        }
      ],
      "sameAs": [
        {%- if settings.social_instagram_link != blank -%}"{{ settings.social_instagram_link | escape }}",{%- endif -%}
        {%- if settings.social_facebook_link != blank -%}"{{ settings.social_facebook_link | escape }}",{%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}"{{ settings.social_pinterest_link | escape }}",{%- endif -%}
        "https://zeyov.com"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": "{{ shop.url }}",
      "name": "ZEYOV | Women’s Maxi Dresses, Gowns & Ethnic Wear Online India",
      "publisher": {
        "@id": "{{ shop.url }}/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonical_url }}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ shop.url }}"
        }
        {%- if template.name == 'collection' and collection.handle -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": "Collections",
            "item": "{{ shop.url }}/collections"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ collection.title | json }},
            "item": "{{ canonical_url }}"
          }
        {%- elsif template.name == 'product' -%}
          {%- if collection -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": "{{ shop.url }}{{ collection.url }}"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": "{{ canonical_url }}"
            }
          {%- else -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": "Products",
              "item": "{{ shop.url }}/collections/all"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": "{{ canonical_url }}"
            }
          {%- endif -%}
        {%- elsif template.name == 'page' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": "{{ canonical_url }}"
          }
        {%- endif -%}
      ]
    }
    {%- if template.name == 'product' -%}
      ,{
        "@type": "Product",
        "@id": "{{ canonical_url }}#product",
        "name": {{ product.title | json }},
        "url": "{{ canonical_url }}",
        "description": {{ product.description | strip_html | truncatewords: 50 | json }},
        "brand": {
          "@type": "Brand",
          "name": "ZEYOV"
        },
        {%- if product.featured_image -%}
          "image": [
            {%- for image in product.images limit: 5 -%}
              "https:{{ image | image_url: width: 1200 }}"{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
        {%- endif -%}
        "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
        "offers": {
          "@type": "Offer",
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | replace: ',', '' }}",
          "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}",
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "{%- if product.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
          "url": "{{ canonical_url }}",
          "seller": {
            "@id": "{{ shop.url }}/#organization"
          }
        }
      }
    {%- elsif template.name == 'collection' -%}
      ,{
        "@type": "CollectionPage",
        "@id": "{{ canonical_url }}#collection",
        "name": {{ collection.title | json }},
        "description": {{ collection.description | default: 'Discover precision-tailored luxury garments, sculpted silhouettes, and handcrafted essentials at ZEYOV.' | strip_html | json }},
        "url": "{{ canonical_url }}",
        "mainEntity": {
          "@type": "ItemList",
          "itemListElement": [
            {%- for item in collection.products limit: 12 -%}
              {
                "@type": "ListItem",
                "position": {{ forloop.index }},
                "name": {{ item.title | json }},
                "url": "{{ shop.url }}{{ item.url }}"
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      }
    {%- endif -%}
  ]
}
</script>
