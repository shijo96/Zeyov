{%- comment -%}
  ZEYOV Official Vector SVG Payment Badges – Tailored for India & Global Checkout
{%- endcomment -%}
<div class="pay-badge-group">
  <div class="pay-icons-wrapper" role="region" aria-label="Accepted payment methods">
    <div class="pay-icons-grid">
      <!-- UPI (Unified Payments Interface) -->
      <span class="pay-badge pay-badge--upi" title="Pay via UPI (GPay, PhonePe, Paytm)">
        <svg viewBox="0 0 68 22" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="UPI">
          <path d="M12 2L6 11L12 20L18 11L12 2Z" fill="#097939"/>
          <path d="M16.5 2L10.5 11L16.5 20L22.5 11L16.5 2Z" fill="#ED752E"/>
          <text x="26" y="15.5" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="900" fill="#07294D" letter-spacing="0.4">UPI</text>
        </svg>
      </span>

      <!-- Google Pay -->
      <span class="pay-badge pay-badge--gpay" title="Google Pay">
        <svg viewBox="0 0 64 22" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Google Pay">
          <circle cx="10" cy="11" r="7.5" fill="#fff"/>
          <path d="M14.5 11.2c0-.5-.04-1-.13-1.4H10v2.7h2.5c-.1.7-.6 1.4-1.3 1.8v1.5h2.1c1.2-1.1 1.9-2.7 1.9-4.6z" fill="#4285F4"/>
          <path d="M10 16.5c1.7 0 3.2-.6 4.3-1.5l-2.1-1.5c-.6.4-1.3.6-2.2.6-1.7 0-3.1-1.1-3.6-2.6H4.2v1.6c1.1 2.1 3.3 3.4 5.8 3.4z" fill="#34A853"/>
          <path d="M6.4 11.5c-.1-.4-.2-.8-.2-1.3s.1-.9.2-1.3V7.3H4.2c-.5.9-.7 1.9-.7 2.9s.2 2 .7 2.9l2.2-1.6z" fill="#FBBC05"/>
          <path d="M10 6.5c1 0 1.8.3 2.5 1l1.8-1.8C13.2 4.7 11.7 4.1 10 4.1 7.5 4.1 5.3 5.5 4.2 7.6l2.2 1.6c.5-1.6 1.9-2.7 3.6-2.7z" fill="#EA4335"/>
          <text x="20" y="15" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="700" fill="#3C4043" letter-spacing="0.2">Pay</text>
        </svg>
      </span>

      <!-- PhonePe -->
      <span class="pay-badge pay-badge--phonepe" title="PhonePe">
        <svg viewBox="0 0 78 22" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="PhonePe">
          <rect x="2" y="2" width="18" height="18" rx="9" fill="#5F259F"/>
          <path d="M11 6v10m0-10c1.4 0 2.6.6 2.6 2 0 1.4-1.2 2-2.6 2H9v-4h2zM8.5 8h5M8.5 10h5" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/>
          <text x="24" y="15" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="800" fill="#5F259F" letter-spacing="0.2">PhonePe</text>
        </svg>
      </span>

      <!-- Paytm -->
      <span class="pay-badge pay-badge--paytm" title="Paytm Wallet &amp; UPI">
        <svg viewBox="0 0 66 22" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Paytm">
          <text x="4" y="15.5" font-family="system-ui, -apple-system, sans-serif" font-size="14" font-weight="900" fill="#002E6E" letter-spacing="-0.4">Pay<tspan fill="#00BAF2">tm</tspan></text>
        </svg>
      </span>

      <!-- RuPay -->
      <span class="pay-badge pay-badge--rupay" title="RuPay Debit &amp; Credit Cards">
        <svg viewBox="0 0 72 22" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="RuPay">
          <path d="M48 3l-3.5 7.5 3.5 7.5h4.5l-3.5-7.5 3.5-7.5h-4.5z" fill="#0079C1"/>
          <path d="M53 3l-3.5 7.5 3.5 7.5h4.5l-3.5-7.5 3.5-7.5h-4.5z" fill="#F37021"/>
          <text x="4" y="15.5" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="900" fill="#002D62" font-style="italic">RuPay</text>
        </svg>
      </span>

      <!-- Visa -->
      <span class="pay-badge pay-badge--visa" title="Visa Cards">
        <svg viewBox="0 0 54 22" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Visa">
          <text x="4" y="16" font-family="'Arial Black', system-ui, sans-serif" font-size="15" font-weight="900" font-style="italic" fill="#1A1F71" letter-spacing="0.6">VISA</text>
        </svg>
      </span>

      <!-- Mastercard -->
      <span class="pay-badge pay-badge--mastercard" title="Mastercard">
        <svg viewBox="0 0 42 22" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Mastercard">
          <circle cx="15" cy="11" r="7" fill="#EB001B"/>
          <circle cx="27" cy="11" r="7" fill="#F79E1B" fill-opacity="0.88"/>
        </svg>
      </span>

      <!-- Net Banking -->
      <span class="pay-badge pay-badge--netbank" title="All Major Indian Banks Net Banking">
        <svg viewBox="0 0 86 22" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Net Banking">
          <path d="M4 17h12v-1.8H4V17zm6-13L4 7v1.8h12V7L10 4zm-4.5 6h1.8v4.5H5.5V10zm3.6 0h1.8v4.5H9.1V10zm3.6 0h1.8v4.5h-1.8V10z" fill="#4A5568"/>
          <text x="20" y="14.5" font-family="system-ui, -apple-system, sans-serif" font-size="10.5" font-weight="700" fill="#2D3748">NetBanking</text>
        </svg>
      </span>
    </div>

    <!-- Trust Badges Strip -->
    <div class="pay-trust-badges">
      <span class="pay-trust-pill pay-trust-pill--free" title="Free Delivery Across India on Prepaid">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span>Free Delivery on Prepaid</span>
      </span>

      <span class="pay-trust-pill pay-trust-pill--cod" title="Cash on Delivery is launching soon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 12h.01M18 12h.01"/></svg>
        <span>COD (Coming Soon)</span>
      </span>
    </div>
  </div>
</div>
