{%- assign _v = variant | default: product.selected_or_first_available_variant -%}
<div class="price" data-price>
  <span class="price__now">{{ _v.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</span>
  {%- if _v.compare_at_price > _v.price -%}
    <s class="price__was">{{ _v.compare_at_price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</s>
    {%- assign _off = _v.compare_at_price | minus: _v.price | times: 100 | divided_by: _v.compare_at_price -%}
    <span class="price__off">{{ _off }}% off</span>
  {%- endif -%}
</div>
