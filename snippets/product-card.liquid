{%- comment -%}
  ZEYOV High-Conversion Product Card (Amazon / Flipkart / Myntra Architecture)
  - Desktop: 4-Column Layout, Elevating Hover, Quick View Overlay, Smooth Image Zoom
  - Mobile: Real Flipkart/Myntra 3:4 Portrait Ratio, Superimposed 4.3★ Rating Pill, Bold Brand, Real-Time Discount & Free Delivery Tag
{%- endcomment -%}

{%- assign v = product.selected_or_first_available_variant -%}
{%- assign card_rating = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value -%}
{%- assign card_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count -%}

<article class="card" data-product-handle="{{ product.handle }}" data-product-id="{{ product.id }}">
  <div class="card__media-wrap">
    {%- if product.images.size > 1 -%}
      <!-- Multi-image swipe slider (Myntra / Flipkart swipe architecture) -->
      <div class="card__slider" data-card-slider>
        <div class="card__slider-track" data-card-track>
          {%- for img in product.images limit: 5 -%}
            <a href="{{ product.url }}" class="card__slider-slide" data-slide-index="{{ forloop.index0 }}" aria-label="{{ product.title | escape }} - View {{ forloop.index }}">
              <img 
                src="{{ img | image_url: width: 700 }}" 
                alt="{{ img.alt | default: product.title | escape }}" 
                width="600" 
                height="800" 
                loading="{% if forloop.first %}lazy{% else %}lazy{% endif %}" 
                class="card__slider-img"
              >
            </a>
          {%- endfor -%}
        </div>
        <div class="card__slider-dots" data-card-dots aria-hidden="true">
          {%- for img in product.images limit: 5 -%}
            <span class="card__slider-dot{% if forloop.first %} is-active{% endif %}"></span>
          {%- endfor -%}
        </div>
        <button type="button" class="card__slider-nav prev" data-card-slide-prev aria-label="Previous photo">&lsaquo;</button>
        <button type="button" class="card__slider-nav next" data-card-slide-next aria-label="Next photo">&rsaquo;</button>
      </div>
    {%- else -%}
      <a class="card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280, 420, 560, 700', sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw', alt: product.featured_image.alt | default: product.title }}
        {%- else -%}
          <div class="card__placeholder">{{ product.title | truncate: 1, '' }}</div>
        {%- endif -%}
      </a>
    {%- endif -%}

    <!-- Top Left Badges: % Off / Bestseller / Sold Out -->
    {%- if v.compare_at_price > v.price -%}
      {%- assign pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -%}
      <span class="card__badge card__badge--sale">{{ pct }}% OFF</span>
    {%- elsif product.tags contains 'bestseller' or product.tags contains 'Bestseller' -%}
      <span class="card__badge card__badge--gold">BESTSELLER</span>
    {%- elsif product.available == false -%}
      <span class="card__badge card__badge--soldout">Sold out</span>
    {%- endif -%}

    <!-- Top Right Wishlist (Heart) Button -->
    <button type="button" class="card__wishlist-btn" data-wishlist-toggle="{{ product.handle }}" data-product-id="{{ product.id }}" data-title="{{ product.title | escape }}" data-price="{{ v.price | money | escape }}" data-image="{{ product.featured_image | image_url: width: 300 }}" data-url="{{ product.url }}" aria-label="Save to Wishlist">
      <svg class="heart-icon heart-empty" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
      <svg class="heart-icon heart-filled" viewBox="0 0 24 24" fill="#E23636" stroke="#E23636" stroke-width="1.8"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
    </button>

    <!-- Superimposed Rating Pill on Image (Only shown when genuine reviews exist) -->
    {%- if card_rating != blank and card_count != blank and card_count > 0 -%}
      <div class="card__rating-pill">
        <span class="rating-val">{{ card_rating | round: 1 }}</span>
        <span class="rating-star">★</span>
        <span class="rating-divider">|</span>
        <span class="rating-num">{{ card_count }}</span>
      </div>
    {%- endif -%}

    <!-- Desktop Hover Overlay Action (Quick View) -->
    <div class="card__hover-bar">
      <button type="button" class="btn btn--small btn--card-quickview" data-quick-view="{{ product.handle }}" aria-label="Quick view {{ product.title | escape }}">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        <span>Quick View</span>
      </button>
    </div>
  </div>

  <div class="card__body">
    <!-- Brand / Collection Line -->
    <div class="card__brand-row">
      <span class="card__brand">{{ product.vendor | default: 'ZEYOV' | upcase }}</span>
      {%- if product.type != blank -%}
        <span class="card__type-tag">{{ product.type | upcase }}</span>
      {%- endif -%}
    </div>

    <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>

    <!-- Flipkart / Myntra Style Price Block -->
    <div class="card__price-row">
      <span class="price__now">{{ v.price | money }}</span>
      {%- if v.compare_at_price > v.price -%}
        <s class="price__was">{{ v.compare_at_price | money }}</s>
        {%- assign pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round -%}
        <span class="price__discount">({{ pct }}% OFF)</span>
      {%- endif -%}
    </div>

    <!-- Trust / Free Delivery Micro Tag -->
    <div class="card__delivery-tag">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span>Free Delivery across India</span>
    </div>

    <div class="card__action">
      {%- if product.available and product.variants.size == 1 -%}
        <form method="post" action="{{ routes.cart_add_url }}" class="card__form" data-ajax-add>
          <input type="hidden" name="id" value="{{ v.id }}">
          <button type="submit" class="btn btn--small btn--luxury btn--block" data-add-bag-btn>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:5px"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"/></svg>
            <span>Add to Bag</span>
          </button>
        </form>
      {%- elsif product.available -%}
        <button type="button" class="btn btn--small btn--luxury btn--block" data-quick-view="{{ product.handle }}">
          <span>Select Size &rarr;</span>
        </button>
      {%- else -%}
        <span class="btn btn--small btn--disabled btn--block">Sold out</span>
      {%- endif -%}
    </div>
  </div>
</article>
