{%- comment -%} Usage: {% render 'product-card', product: product, lazy: true %} {%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
{%- assign img1 = product.featured_media -%}
{%- assign img2 = product.media[1] -%}
{%- assign color_opt = nil -%}
{%- for o in product.options_with_values -%}
  {%- assign _on = o.name | downcase -%}
  {%- if _on contains 'colo' -%}{%- assign color_opt = o -%}{%- endif -%}
{%- endfor -%}
<article class="card" data-product-card data-handle="{{ product.handle }}">
  <div class="card__media">
    <a href="{{ product.url | within: collection }}" aria-label="{{ product.title | escape }}">
      {%- if img1 -%}
        {{ img1 | image_url: width: 720 | image_tag: loading: 'lazy', decoding: 'async', widths: '360, 540, 720', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw', alt: product.title }}
        {%- if settings.show_second_image and img2 -%}
          {%- comment -%} hover photo loads only when a mouse hovers the card (saves data on phones) {%- endcomment -%}
          <img class="alt" alt="" width="{{ img2.preview_image.width | default: 720 }}" height="{{ img2.preview_image.height | default: 900 }}" decoding="async" data-hover-src="{{ img2 | image_url: width: 540 }}" data-hover-srcset="{{ img2 | image_url: width: 360 }} 360w, {{ img2 | image_url: width: 540 }} 540w, {{ img2 | image_url: width: 720 }} 720w" sizes="(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw">
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag }}
      {%- endif -%}
    </a>
    <div class="card__badges">
      {%- if product.available == false -%}<span class="badge">Sold out</span>
      {%- elsif v.compare_at_price > v.price -%}
        {%- assign off = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
        <span class="badge badge--sale">-{{ off }}%</span>
      {%- endif -%}
      {%- if product.tags contains 'bestseller' -%}<span class="badge badge--gold">Bestseller</span>{%- endif -%}
      {%- if product.tags contains 'new' -%}<span class="badge badge--soft">New</span>{%- endif -%}
    </div>
    <button type="button" class="heart" data-wish="{{ product.handle }}" aria-label="Add {{ product.title | escape }} to wishlist" aria-pressed="false">
      <svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.4-7.5-10.1A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.6C19.5 15.6 12 20 12 20z"/></svg>
    </button>
    {%- if product.available -%}
      <div class="card__quick"><button type="button" class="btn btn--sm" data-quick-add="{{ product.handle }}">Quick add</button></div>
      <button type="button" class="card__plus" data-quick-add="{{ product.handle }}" aria-label="Quick add {{ product.title | escape }}">{% render 'icon', name: 'plus' %}</button>
    {%- endif -%}
  </div>
  <div class="card__info">
    {%- if product.type != blank -%}<span class="card__meta">{{ product.type }}</span>{%- endif -%}
    <a href="{{ product.url | within: collection }}" class="card__title">{{ product.title }}</a>
    {%- if settings.show_rating -%}{% render 'rating', product: product, compact: true %}{%- endif -%}
    {% render 'price', product: product %}
    {%- if color_opt and color_opt.values.size > 1 -%}
      <div class="swatches" aria-label="{{ color_opt.values.size }} colours">
        {%- for val in color_opt.values limit: 6 -%}
          <span class="swatch-dot" title="{{ val | escape }}" style="background: {% render 'swatch-hex', name: val %}"></span>
        {%- endfor -%}
        {%- if color_opt.values.size > 6 -%}<span class="more">+{{ color_opt.values.size | minus: 6 }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>
