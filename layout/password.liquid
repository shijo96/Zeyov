<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ZEYOV</title>
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body{margin:0;min-height:100vh;display:grid;place-items:center;background:#FAF8F4;font-family:'Inter',system-ui,sans-serif;color:#20201F;text-align:center;padding:24px}
    .box{max-width:420px;background:#FFFFFF;border:1px solid #E5DED5;padding:40px 28px;border-radius:20px;box-shadow:0 20px 60px rgba(51,37,31,.08)}
    img{width:200px;max-width:70%}
    h1{font-family:'Playfair Display',Georgia,serif;font-size:2rem;margin:16px 0 6px;color:#20201F}
    p{color:#77716B}
    input{width:100%;box-sizing:border-box;padding:14px;border:1px solid #E5DED5;border-radius:10px;margin:6px 0;font:inherit}
    button{width:100%;padding:14px;border:0;border-radius:10px;background:#33251F;color:#fff;font:inherit;font-weight:600;cursor:pointer;margin-top:6px}
  </style>
  {{ content_for_header }}
</head>
<body>
  <div class="box">
    <img src="{{ 'zeyov-logo.png' | asset_url }}" alt="ZEYOV" width="220" height="88">
    <h1>Opening soon</h1>
    <p>{{ shop.password_message | default: 'Style for a brighter you. Our store is almost ready.' }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Enter password" autocomplete="current-password" required>
      <button type="submit">Enter</button>
    {% endform %}
  </div>
  {{ content_for_layout }}
</body>
</html>
