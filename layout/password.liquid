<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name }} – opening soon</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<style>:root{--bg:{{ settings.color_bg }};--surface:{{ settings.color_surface }};--text:{{ settings.color_text }};--muted:{{ settings.color_muted }};--gold:{{ settings.color_gold }};--sale:{{ settings.color_sale }};--line:{{ settings.color_line }}}</style>
{{ 'base.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head>
<body style="padding:0">{{ content_for_layout }}</body></html>
