<section class="section">
  <div class="wrap"><div class="newsletter">
    <span class="eyebrow">Join the list</span>
    <h2>{{ section.settings.heading }}</h2>
    <p class="muted">{{ section.settings.text }}</p>
    {%- form 'customer', class: 'newsletter__form' -%}
      {%- if form.posted_successfully? -%}<p class="notice">You're on the list. Watch your inbox for the next drop.</p>{%- endif -%}
      <div class="field-inline">
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">Email</label>
      <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Your email" required autocomplete="email">
      <button class="btn btn--sm" type="submit">Subscribe</button>
      </div>
    {%- endform -%}
  </div></div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "First look at every drop" },
    { "type": "text", "id": "text", "label": "Text", "default": "New colours, restocks and members-only offers. No spam." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
