{%- assign menu = linklists[section.settings.menu] -%}
<header class="header{% if section.settings.sticky %} is-sticky{% endif %}" data-header>
  <div class="container header__inner">
    <button class="icon-btn header__burger" type="button" data-open="NavDrawer" aria-label="Open menu">{% render 'icon', name: 'menu' %}</button>

    {%- assign header_logo = section.settings.logo | default: settings.logo -%}
    <a class="header__logo" href="{{ routes.root_url }}" aria-label="ZEYOV" style="display:inline-flex;align-items:center;min-width:130px;flex-shrink:0;margin-right:clamp(12px, 1.8vw, 28px);">
      {%- if header_logo != blank -%}
        {{ header_logo | image_url: width: 500 | image_tag: alt: 'ZEYOV', loading: 'eager', class: 'logo-img', style: 'display:block;width:150px;max-width:165px;height:auto;object-fit:contain;' }}
      {%- else -%}
        <img class="logo-img" src="{{ 'zeyov-logo.png' | asset_url }}" alt="ZEYOV" width="300" height="120" loading="eager" style="display:block;width:150px;max-width:165px;height:auto;object-fit:contain;">
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="Main Navigation">
      <ul role="list">
        {%- if section.settings.use_custom_nav == false and menu != blank and menu.links.size > 3 -%}
          {%- for link in menu.links -%}
            <li class="{% if link.links.size > 0 %}has-sub{% endif %}">
              <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                {{ link.title }}
                {%- if link.title contains 'Sale' or link.title contains 'Offer' -%}
                  <span class="nav-badge--sale">Save</span>
                {%- endif -%}
                {% if link.links.size > 0 %}{% render 'icon', name: 'chevron' %}{% endif %}
              </a>
              {%- if link.links.size > 0 -%}
                <ul class="sub" role="list">
                  {%- for sub in link.links -%}
                    <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- Master ZEYOV Fashion Navigation Structure (Clean Active Collections) -->
          <li><a href="{{ routes.collections_url }}/new-arrivals">New Arrivals <span class="nav-badge--sale" style="background:var(--gold-dark);">New</span></a></li>

          <!-- WOMEN'S WEAR MEGA MENU -->
          <li class="has-mega">
            <a href="{{ routes.collections_url }}/womens-wear">
              Women's Wear {% render 'icon', name: 'chevron' %}
            </a>
            <div class="mega-dropdown">
              <div class="container mega-dropdown__inner">
                <div class="mega-dropdown__grid">
                  <div>
                    <span class="mega-dropdown__col-title">Apparel Categories</span>
                    <a href="{{ routes.collections_url }}/womens-wear" class="mega-dropdown__link">All Women's Pieces</a>
                    <a href="{{ routes.collections_url }}/western-wear" class="mega-dropdown__link">Western Wear</a>
                    <a href="{{ routes.collections_url }}/womens-dresses" class="mega-dropdown__link">Dresses &amp; Gowns</a>
                  </div>
                  <div>
                    <span class="mega-dropdown__col-title">Separates &amp; Seasonal</span>
                    <a href="{{ routes.collections_url }}/womens-tops-tshirts" class="mega-dropdown__link">Tops &amp; T-Shirts</a>
                    <a href="{{ routes.collections_url }}/womens-bottomwear" class="mega-dropdown__link">Bottomwear &amp; Trousers</a>
                    <a href="{{ routes.collections_url }}/womens-winter-wear" class="mega-dropdown__link">Winter Wear</a>
                  </div>
                </div>
                <div class="mega-dropdown__featured-card">
                  <div>
                    <span class="mega-dropdown__card-tag">RUNWAY COUTURE</span>
                    <h4 class="mega-dropdown__card-heading">Teddy Fur &amp; Silk Silhouette</h4>
                    <p class="mega-dropdown__card-desc">Sculpted to flatter Indian silhouettes with pre-shrunk colorfast integrity.</p>
                  </div>
                  <a href="{{ routes.collections_url }}/womens-wear" class="mega-dropdown__card-btn">Shop All Women's &rarr;</a>
                </div>
              </div>
            </div>
          </li>

          <!-- MEN'S WEAR MEGA MENU -->
          <li class="has-mega">
            <a href="{{ routes.collections_url }}/mens-wear">
              Men's Wear {% render 'icon', name: 'chevron' %}
            </a>
            <div class="mega-dropdown">
              <div class="container mega-dropdown__inner">
                <div class="mega-dropdown__grid">
                  <div>
                    <span class="mega-dropdown__col-title">Upper Wear</span>
                    <a href="{{ routes.collections_url }}/mens-wear" class="mega-dropdown__link">All Men's Pieces</a>
                    <a href="{{ routes.collections_url }}/mens-tshirts" class="mega-dropdown__link">T-Shirts &amp; Polos</a>
                    <a href="{{ routes.collections_url }}/mens-shirts" class="mega-dropdown__link">Casual &amp; Formal Shirts</a>
                  </div>
                  <div>
                    <span class="mega-dropdown__col-title">Bottoms &amp; Outerwear</span>
                    <a href="{{ routes.collections_url }}/mens-trousers" class="mega-dropdown__link">Trousers &amp; Cargo Pants</a>
                    <a href="{{ routes.collections_url }}/mens-winterwear" class="mega-dropdown__link">Sweatshirts &amp; Jackets</a>
                    <a href="{{ routes.collections_url }}/mens-accessories" class="mega-dropdown__link">Belts &amp; Accessories</a>
                  </div>
                </div>
                <div class="mega-dropdown__featured-card" style="background:linear-gradient(145deg, #242c27 0%, #171d1a 100%);">
                  <div>
                    <span class="mega-dropdown__card-tag" style="background:rgba(255,255,255,0.15);color:#F4EBD9;">MEN'S EDIT • SS25</span>
                    <h4 class="mega-dropdown__card-heading" style="color:#FAF8F4;">Waffle Knits &amp; Colorblock</h4>
                    <p class="mega-dropdown__card-desc" style="color:rgba(255,255,255,0.72);">Textured heavyweight knits, tailored collars, and urban essentials.</p>
                  </div>
                  <a href="{{ routes.collections_url }}/mens-wear" class="mega-dropdown__card-btn">Shop Men's Edit &rarr;</a>
                </div>
              </div>
            </div>
          </li>

          <!-- ACCESSORIES MEGA MENU -->
          <li class="has-mega">
            <a href="{{ routes.collections_url }}/accessories">
              Accessories {% render 'icon', name: 'chevron' %}
            </a>
            <div class="mega-dropdown">
              <div class="container mega-dropdown__inner">
                <div class="mega-dropdown__grid">
                  <div>
                    <span class="mega-dropdown__col-title">Bags &amp; Accents</span>
                    <a href="{{ routes.collections_url }}/accessories" class="mega-dropdown__link">All Accessories</a>
                    <a href="{{ routes.collections_url }}/handbags-totes" class="mega-dropdown__link">Handbags &amp; Totes</a>
                    <a href="{{ routes.collections_url }}/jewellery-accents" class="mega-dropdown__link">Jewellery &amp; Accents</a>
                  </div>
                  <div>
                    <span class="mega-dropdown__col-title">Footwear &amp; Essentials</span>
                    <a href="{{ routes.collections_url }}/footwear" class="mega-dropdown__link">Footwear &amp; Heels</a>
                    <a href="{{ routes.collections_url }}/belts-scarves" class="mega-dropdown__link">Belts &amp; Scarves</a>
                    <a href="{{ routes.collections_url }}/fragrances" class="mega-dropdown__link">Luxury Fragrances</a>
                  </div>
                </div>
                <div class="mega-dropdown__featured-card" style="background:linear-gradient(145deg, #362921 0%, #221812 100%);">
                  <div>
                    <span class="mega-dropdown__card-tag" style="background:rgba(255,255,255,0.15);color:#F4EBD9;">CURATED ACCENTS</span>
                    <h4 class="mega-dropdown__card-heading" style="color:#FAF8F4;">Complete The Runway Look</h4>
                    <p class="mega-dropdown__card-desc" style="color:rgba(255,255,255,0.72);">Artisan-crafted leather goods, silk scarves, and premium fashion accents.</p>
                  </div>
                  <a href="{{ routes.collections_url }}/accessories" class="mega-dropdown__card-btn">Explore Accessories &rarr;</a>
                </div>
              </div>
            </div>
          </li>

          <!-- KIDSWEAR MEGA MENU -->
          <li class="has-mega">
            <a href="{{ routes.collections_url }}/kidswear">
              Kidswear {% render 'icon', name: 'chevron' %}
            </a>
            <div class="mega-dropdown">
              <div class="container mega-dropdown__inner">
                <div class="mega-dropdown__grid">
                  <div>
                    <span class="mega-dropdown__col-title">Baby &amp; Toddler</span>
                    <a href="{{ routes.collections_url }}/kidswear" class="mega-dropdown__link">All Kidswear</a>
                    <a href="{{ routes.collections_url }}/baby-rompers" class="mega-dropdown__link">Rompers &amp; Jumpsuits</a>
                    <a href="{{ routes.collections_url }}/baby-winterwear" class="mega-dropdown__link">Baby Winterwear &amp; Fleece</a>
                  </div>
                  <div>
                    <span class="mega-dropdown__col-title">Boys &amp; Girls</span>
                    <a href="{{ routes.collections_url }}/boys-fashion" class="mega-dropdown__link">Boys Casuals &amp; Tees</a>
                    <a href="{{ routes.collections_url }}/girls-dresses" class="mega-dropdown__link">Girls Dresses &amp; Frocks</a>
                    <a href="{{ routes.collections_url }}/kids-sets" class="mega-dropdown__link">Matching Co-ord Sets</a>
                  </div>
                </div>
                <div class="mega-dropdown__featured-card" style="background:linear-gradient(145deg, #3b332a 0%, #262019 100%);">
                  <div>
                    <span class="mega-dropdown__card-tag" style="background:rgba(255,255,255,0.15);color:#F4EBD9;">GENTLE COMFORT</span>
                    <h4 class="mega-dropdown__card-heading" style="color:#FAF8F4;">Ultra-Soft Fleece &amp; Cotton</h4>
                    <p class="mega-dropdown__card-desc" style="color:rgba(255,255,255,0.72);">Hypoallergenic, breathable fabrics made for everyday play and baby comfort.</p>
                  </div>
                  <a href="{{ routes.collections_url }}/kidswear" class="mega-dropdown__card-btn">Shop Kidswear &rarr;</a>
                </div>
              </div>
            </div>
          </li>

          <li><a href="{{ routes.all_products_collection_url }}">All Creations</a></li>

          {%- assign track_link = pages['track-order'].url | default: pages['track-your-order'].url | default: pages['order-tracking'].url | default: '/pages/track-order' -%}
          <li><a href="{{ track_link }}">Track Order</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- Prominent Desktop Search Bar (Amazon / Myntra Style) -->
    <div class="header__desktop-search" role="search">
      <form action="{{ routes.search_url }}" method="get" class="header__search-box">
        <svg class="header__search-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="search" name="q" placeholder="Search dresses, kurtas, silks, kidswear…" aria-label="Search Catalog" autocomplete="off" minlength="2">
        <input type="hidden" name="type" value="product">
      </form>
    </div>

    <div class="header__actions">
      <button class="icon-btn header__search-trigger" type="button" data-open="SearchPanel" aria-label="Search">{% render 'icon', name: 'search' %}</button>
      <button class="icon-btn header__wishlist" type="button" data-open-wishlist aria-label="Wishlist">
        {% render 'icon', name: 'heart' %}
        <span class="wishlist-count is-empty" data-wishlist-count>0</span>
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
      <a class="icon-btn header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="search-panel" id="SearchPanel" hidden>
    <div class="container">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <input type="search" name="q" placeholder="Search dresses, jackets, luxury fashion, living…" aria-label="Search" autocomplete="off" minlength="2" maxlength="100" required>
        <input type="hidden" name="type" value="product">
        <button class="btn btn--gold" type="submit">Search</button>
        <button class="icon-btn" type="button" data-close="SearchPanel" aria-label="Close search">{% render 'icon', name: 'close' %}</button>
      </form>
    </div>
  </div>
</header>

<div class="drawer-overlay" data-overlay hidden></div>
<aside class="drawer" id="NavDrawer" hidden aria-label="Menu">
  <div class="drawer__head">
    <img src="{{ 'zeyov-logo.png' | asset_url }}" alt="ZEYOV" width="130" height="52">
    <button class="icon-btn" type="button" data-close="NavDrawer" aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
  </div>
  <ul class="drawer__list" role="list">
    <li><a href="{{ routes.root_url }}">Home</a></li>
    <li>
      <a href="{{ routes.collections_url }}/new-arrivals" style="display:flex;align-items:center;justify-content:space-between;">
        <span>New Arrivals</span>
        <span class="nav-badge--sale" style="background:var(--gold-dark);margin:0;">Fresh Drop</span>
      </a>
    </li>

    <!-- Women's Wear Accordion -->
    <li>
      <details class="drawer__accordion" open>
        <summary class="drawer__accordion-summary">
          <span>Women's Collection</span>
          <svg class="drawer__accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="drawer__accordion-sublist">
          <a class="drawer__view-all-link" href="{{ routes.collections_url }}/womens-wear">All Women's Pieces &rarr;</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/western-wear">Western Wear</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/womens-dresses">Dresses &amp; Gowns</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/womens-tops-tshirts">Tops &amp; T-Shirts</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/womens-bottomwear">Bottomwear &amp; Trousers</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/womens-winter-wear">Winter Wear</a>
        </div>
      </details>
    </li>

    <!-- Men's Collection Accordion -->
    <li>
      <details class="drawer__accordion">
        <summary class="drawer__accordion-summary">
          <span>Men's Collection</span>
          <svg class="drawer__accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="drawer__accordion-sublist">
          <a class="drawer__view-all-link" href="{{ routes.collections_url }}/mens-wear">All Men's Pieces &rarr;</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/mens-tshirts">T-Shirts &amp; Polos</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/mens-shirts">Casual &amp; Formal Shirts</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/mens-trousers">Trousers &amp; Cargo Pants</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/mens-winterwear">Sweatshirts &amp; Jackets</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/mens-accessories">Belts &amp; Accessories</a>
        </div>
      </details>
    </li>

    <!-- Accessories Accordion -->
    <li>
      <details class="drawer__accordion">
        <summary class="drawer__accordion-summary">
          <span>Accessories</span>
          <svg class="drawer__accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="drawer__accordion-sublist">
          <a class="drawer__view-all-link" href="{{ routes.collections_url }}/accessories">All Accessories &rarr;</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/handbags-totes">Handbags &amp; Totes</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/footwear">Footwear &amp; Heels</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/jewellery-accents">Jewellery &amp; Accents</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/belts-scarves">Belts &amp; Scarves</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/fragrances">Luxury Fragrances</a>
        </div>
      </details>
    </li>

    <!-- Kidswear Accordion -->
    <li>
      <details class="drawer__accordion">
        <summary class="drawer__accordion-summary">
          <span>Kidswear &amp; Baby</span>
          <svg class="drawer__accordion-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="drawer__accordion-sublist">
          <a class="drawer__view-all-link" href="{{ routes.collections_url }}/kidswear">All Kidswear &rarr;</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/baby-rompers">Baby Rompers &amp; Jumpsuits</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/baby-winterwear">Baby Winterwear &amp; Fleece</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/boys-fashion">Boys Casuals &amp; Tees</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/girls-dresses">Girls Dresses &amp; Frocks</a>
          <a class="drawer__accordion-sublink" href="{{ routes.collections_url }}/kids-sets">Matching Co-ord Sets</a>
        </div>
      </details>
    </li>

    <li><a href="{{ routes.all_products_collection_url }}">All Creations</a></li>

    {%- assign track_link = pages['track-order'].url | default: pages['track-your-order'].url | default: pages['order-tracking'].url | default: '/pages/track-order' -%}
    {%- assign about_link = pages['about-us'].url | default: pages['about'].url | default: pages['about-zeyov'].url | default: '/pages/about-us' -%}
    {%- assign contact_link = pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us' -%}
    {%- assign faq_link = pages['faq'].url | default: pages['faqs'].url | default: pages['frequently-asked-questions'].url | default: '/pages/faq' -%}
    <li style="border-top:1px solid rgba(229,222,213,0.5);margin-top:12px;padding-top:10px;"><a href="{{ track_link }}">Track Your Order</a></li>
    <li><a href="{{ about_link }}">About Zeyov</a></li>
    <li><a href="{{ contact_link }}">Contact Us</a></li>
    <li><a href="{{ faq_link }}">FAQs</a></li>
    <li><a href="{{ routes.cart_url }}">Cart ({% if cart.item_count > 0 %}{{ cart.item_count }}{% else %}0{% endif %})</a></li>
    {%- if shop.customer_accounts_enabled -%}
      <li><a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{% if customer %}My account{% else %}Login / Sign up{% endif %}</a></li>
      {%- if customer -%}<li><a href="{{ routes.account_addresses_url }}">My addresses</a></li>{%- endif -%}
    {%- endif -%}
  </ul>

  {%- if settings.whatsapp_number != blank -%}
    <div class="drawer__contact-box">
      <a class="btn btn--small btn--gold btn--block" href="https://wa.me/{{ settings.whatsapp_number | replace: '+', '' | replace: ' ', '' }}" target="_blank" rel="noopener">
        {% render 'icon', name: 'whatsapp' %} WhatsApp Support
      </a>
    </div>
  {%- endif -%}

  <p class="drawer__foot">ZEYOV &bull; Style for a Brighter You</p>
</aside>

<!-- Wishlist Drawer (Right Slide-in) -->
<aside class="drawer drawer--right" id="WishlistDrawer" hidden aria-label="Wishlist">
  <div class="drawer__head">
    <div class="drawer__head-title">
      <span class="eyebrow" style="margin:0">SAVED PIECES</span>
      <h3 style="margin:0;font-size:1.25rem">Your Wishlist (<span data-wishlist-count-text>0</span>)</h3>
    </div>
    <button class="icon-btn" type="button" data-close-wishlist aria-label="Close wishlist">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="wishlist-drawer__body" id="WishlistItems">
    <!-- Populated dynamically via JS -->
  </div>
  <div class="wishlist-drawer__empty" id="WishlistEmptyState">
    <div class="wishlist-empty-icon">{% render 'icon', name: 'heart' %}</div>
    <h4>Your Wishlist is Empty</h4>
    <p class="muted small">Save pieces from our Runway Atelier collection to review or purchase anytime.</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--small btn--luxury">Explore Collection</a>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Header logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true }
  ]
}
{% endschema %}
