{%- assign menu = linklists[section.settings.menu] -%}
<header class="header{% if section.settings.sticky %} is-sticky{% endif %}" data-header>
  <div class="container header__inner">
    <button class="icon-btn header__burger" type="button" data-open="NavDrawer" aria-label="Open menu">{% render 'icon', name: 'menu' %}</button>

    <a class="header__logo" href="{{ routes.root_url }}" aria-label="ZEYOV">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 500 | image_tag: alt: 'ZEYOV', loading: 'eager', class: 'logo-img' }}
      {%- else -%}
        <img class="logo-img" src="{{ 'zeyov-logo.png' | asset_url }}" alt="ZEYOV" width="300" height="120">
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="Main Navigation">
      <ul role="list">
        {%- if section.settings.use_custom_nav == false and menu != blank and menu.links.size > 3 -%}
          {%- for link in menu.links -%}
            <li class="{% if link.links.size > 0 %}has-sub{% endif %}">
              <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                {{ link.title }}
                {%- if link.title contains 'Sale' or link.title contains 'Offer' -%}
                  <span class="nav-badge--sale">Save</span>
                {%- endif -%}
                {% if link.links.size > 0 %}{% render 'icon', name: 'chevron' %}{% endif %}
              </a>
              {%- if link.links.size > 0 -%}
                <ul class="sub" role="list">
                  {%- for sub in link.links -%}
                    <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- Master ZEYOV Fashion Navigation Structure -->
          <li><a href="{{ routes.root_url }}">Home</a></li>

          <!-- KIDSWEAR MEGA MENU -->
          <li class="has-mega">
            <a href="{{ routes.collections_url }}/kidswear">
              Kidswear {% render 'icon', name: 'chevron' %}
            </a>
            <div class="mega-dropdown">
              <div class="container mega-dropdown__inner">
                <div class="mega-dropdown__grid">
                  <div>
                    <span class="mega-dropdown__col-title">Baby &amp; Toddlers</span>
                    <a href="{{ routes.collections_url }}/baby-clothing" class="mega-dropdown__link">Baby Clothing</a>
                    <a href="{{ routes.collections_url }}/baby-rompers" class="mega-dropdown__link">Baby Rompers &amp; Onesies</a>
                    <a href="{{ routes.collections_url }}/kids-accessories" class="mega-dropdown__link">Kids Accessories</a>
                  </div>
                  <div>
                    <span class="mega-dropdown__col-title">Boys &amp; Girls</span>
                    <a href="{{ routes.collections_url }}/boys-clothing" class="mega-dropdown__link">Boys Clothing</a>
                    <a href="{{ routes.collections_url }}/girls-clothing" class="mega-dropdown__link">Girls Clothing</a>
                    <a href="{{ routes.collections_url }}/kids-dresses" class="mega-dropdown__link">Kids Dresses &amp; Frocks</a>
                    <a href="{{ routes.collections_url }}/kids-tops-bottoms" class="mega-dropdown__link">Tops &amp; Bottomwear</a>
                  </div>
                </div>
                <div class="mega-dropdown__featured-card">
                  <div>
                    <span class="mega-dropdown__card-tag">LITTLE ATELIER</span>
                    <h4 class="mega-dropdown__card-heading">Cozy &amp; Fluffy Baby Rompers</h4>
                    <p class="mega-dropdown__card-desc">Reversible thermal flannel rompers &amp; gentle cotton essentials for Indian weather.</p>
                  </div>
                  <a href="{{ routes.collections_url }}/kidswear" class="mega-dropdown__card-btn">Shop All Kidswear &rarr;</a>
                </div>
              </div>
            </div>
          </li>

          <!-- WOMEN'S WEAR MEGA MENU -->
          <li class="has-mega">
            <a href="{{ routes.collections_url }}/womens-wear">
              Women's Wear {% render 'icon', name: 'chevron' %}
            </a>
            <div class="mega-dropdown">
              <div class="container mega-dropdown__inner">
                <div class="mega-dropdown__grid">
                  <div>
                    <span class="mega-dropdown__col-title">Dresses &amp; Gowns</span>
                    <a href="{{ routes.collections_url }}/womens-maxi-dresses" class="mega-dropdown__link">Maxi Dresses</a>
                    <a href="{{ routes.collections_url }}/cotton-dresses" class="mega-dropdown__link">Cotton Dresses</a>
                    <a href="{{ routes.collections_url }}/designer-gowns" class="mega-dropdown__link">Designer Gowns</a>
                    <a href="{{ routes.collections_url }}/plus-size-dresses" class="mega-dropdown__link">Plus Size Dresses</a>
                    <a href="{{ routes.collections_url }}/womens-dresses" class="mega-dropdown__link">All Dresses &amp; Gowns</a>
                  </div>
                  <div>
                    <span class="mega-dropdown__col-title">Ethnic &amp; Fusion</span>
                    <a href="{{ routes.collections_url }}/ethnic-wear" class="mega-dropdown__link">Kurtis &amp; Ethnic Wear</a>
                    <a href="{{ routes.collections_url }}/coord-sets" class="mega-dropdown__link">Co-ord Sets</a>
                    <a href="{{ routes.collections_url }}/western-wear" class="mega-dropdown__link">Western Wear</a>
                    <a href="{{ routes.collections_url }}/womens-bottomwear" class="mega-dropdown__link">Bottomwear &amp; Trousers</a>
                    <a href="{{ routes.collections_url }}/womens-accessories" class="mega-dropdown__link">Women's Accessories</a>
                  </div>
                </div>
                <div class="mega-dropdown__featured-card">
                  <div>
                    <span class="mega-dropdown__card-tag">RUNWAY COUTURE</span>
                    <h4 class="mega-dropdown__card-heading">Teddy Fur &amp; Silk Silhouette</h4>
                    <p class="mega-dropdown__card-desc">Sculpted to flatter Indian silhouettes with pre-shrunk colorfast integrity.</p>
                  </div>
                  <a href="{{ routes.collections_url }}/womens-wear" class="mega-dropdown__card-btn">Shop All Women's &rarr;</a>
                </div>
              </div>
            </div>
          </li>

          <!-- MEN'S WEAR MEGA MENU -->
          <li class="has-mega">
            <a href="{{ routes.collections_url }}/mens-wear">
              Men's Wear {% render 'icon', name: 'chevron' %}
            </a>
            <div class="mega-dropdown">
              <div class="container mega-dropdown__inner">
                <div class="mega-dropdown__grid">
                  <div>
                    <span class="mega-dropdown__col-title">Everyday &amp; Casual</span>
                    <a href="{{ routes.collections_url }}/mens-tshirts" class="mega-dropdown__link">T-Shirts &amp; Polos</a>
                    <a href="{{ routes.collections_url }}/mens-shirts" class="mega-dropdown__link">Casual &amp; Formal Shirts</a>
                    <a href="{{ routes.collections_url }}/mens-casual-wear" class="mega-dropdown__link">Casual Jackets &amp; Vests</a>
                  </div>
                  <div>
                    <span class="mega-dropdown__col-title">Bottoms &amp; Accessories</span>
                    <a href="{{ routes.collections_url }}/mens-trousers" class="mega-dropdown__link">Trousers &amp; Chinos</a>
                    <a href="{{ routes.collections_url }}/mens-jeans" class="mega-dropdown__link">Denim Jeans</a>
                    <a href="{{ routes.collections_url }}/mens-ethnic-wear" class="mega-dropdown__link">Men's Ethnic Wear</a>
                    <a href="{{ routes.collections_url }}/mens-accessories" class="mega-dropdown__link">Belts &amp; Accessories</a>
                  </div>
                </div>
                <div class="mega-dropdown__featured-card">
                  <div>
                    <span class="mega-dropdown__card-tag">MODERN TAILORING</span>
                    <h4 class="mega-dropdown__card-heading">Tailored Mobility &amp; Fit</h4>
                    <p class="mega-dropdown__card-desc">Generous shoulder ergonomics and premium breathable fabrics designed for all-day comfort.</p>
                  </div>
                  <a href="{{ routes.collections_url }}/mens-wear" class="mega-dropdown__card-btn">Shop All Men's &rarr;</a>
                </div>
              </div>
            </div>
          </li>

          <!-- FESTIVE COLLECTION MEGA MENU -->
          <li class="has-mega">
            <a href="{{ routes.collections_url }}/festive-collection">
              Festive {% render 'icon', name: 'chevron' %}
            </a>
            <div class="mega-dropdown">
              <div class="container mega-dropdown__inner">
                <div class="mega-dropdown__grid">
                  <div>
                    <span class="mega-dropdown__col-title">Celebration Edits</span>
                    <a href="{{ routes.collections_url }}/christmas-collection" class="mega-dropdown__link">Christmas Collection</a>
                    <a href="{{ routes.collections_url }}/onam-collection" class="mega-dropdown__link">Onam Collection</a>
                    <a href="{{ routes.collections_url }}/vishu-collection" class="mega-dropdown__link">Vishu Collection</a>
                    <a href="{{ routes.collections_url }}/eid-collection" class="mega-dropdown__link">Eid Collection</a>
                  </div>
                  <div>
                    <span class="mega-dropdown__col-title">Season &amp; Specials</span>
                    <a href="{{ routes.collections_url }}/diwali-collection" class="mega-dropdown__link">Diwali Collection</a>
                    <a href="{{ routes.collections_url }}/new-year-collection" class="mega-dropdown__link">New Year Collection</a>
                    <a href="{{ routes.collections_url }}/valentines-collection" class="mega-dropdown__link">Valentine's Collection</a>
                    <a href="{{ routes.collections_url }}/festival-specials" class="mega-dropdown__link">All Festival Specials</a>
                  </div>
                </div>
                <div class="mega-dropdown__featured-card">
                  <div>
                    <span class="mega-dropdown__card-tag">FESTIVE EXCLUSIVE</span>
                    <h4 class="mega-dropdown__card-heading">Timeless Celebration Drops</h4>
                    <p class="mega-dropdown__card-desc">Curated festive couture for Indian festivities. Pre-order and express delivery across India.</p>
                  </div>
                  <a href="{{ routes.collections_url }}/festive-collection" class="mega-dropdown__card-btn">Explore Festive Edit &rarr;</a>
                </div>
              </div>
            </div>
          </li>

          <li><a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a></li>
          {% comment %} <li><a href="{{ routes.collections_url }}/best-sellers">Best Sellers</a></li> {% endcomment %}
          {% comment %} <li>
            <a href="{{ routes.collections_url }}/sale" style="color:var(--sale);">
              Sale <span class="nav-badge--sale">Save Extra</span>
            </a>
          </li> {% endcomment %}
          {%- assign contact_link = pages['contact-us'].url | default: pages['contact'].url | default: '/pages/contact-us' -%}
          <li><a href="{{ contact_link }}">Contact</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="header__actions">
      <button class="icon-btn" type="button" data-open="SearchPanel" aria-label="Search">{% render 'icon', name: 'search' %}</button>
      <button class="icon-btn header__wishlist" type="button" data-open-wishlist aria-label="Wishlist">
        {% render 'icon', name: 'heart' %}
        <span class="wishlist-count is-empty" data-wishlist-count>0</span>
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
      <a class="icon-btn header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="search-panel" id="SearchPanel" hidden>
    <div class="container">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <input type="search" name="q" placeholder="Search dresses, jackets, luxury fashion, living…" aria-label="Search" autocomplete="off" minlength="2" maxlength="100" required>
        <input type="hidden" name="type" value="product">
        <button class="btn btn--gold" type="submit">Search</button>
        <button class="icon-btn" type="button" data-close="SearchPanel" aria-label="Close search">{% render 'icon', name: 'close' %}</button>
      </form>
    </div>
  </div>
</header>

