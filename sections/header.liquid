<!-- Wishlist Drawer (Right Slide-in) -->
<aside class="drawer drawer--right" id="WishlistDrawer" hidden aria-label="Wishlist">
  <div class="drawer__head">
    <div class="drawer__head-title">
      <span class="eyebrow" style="margin:0">SAVED PIECES</span>
      <h3 style="margin:0;font-size:1.25rem">Your Wishlist (<span data-wishlist-count-text>0</span>)</h3>
    </div>
    <button class="icon-btn" type="button" data-close-wishlist aria-label="Close wishlist">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="wishlist-drawer__body" id="WishlistItems">
    <!-- Populated dynamically via JS -->
  </div>
  <div class="wishlist-drawer__empty" id="WishlistEmptyState">
    <div class="wishlist-empty-icon">{% render 'icon', name: 'heart' %}</div>
    <h4>Your Wishlist is Empty</h4>
    <p class="muted small">Save pieces from our Runway Atelier collection to review or purchase anytime.</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--small btn--luxury">Explore Collection</a>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true }
  ]
}
{% endschema %}
