<section class="section" style="padding-top:28px">
  <div class="wrap">
    <div class="section-head"><h2>{{ section.settings.heading }}</h2><a class="link" href="{{ routes.collections_url }}">View all</a></div>
    <div class="cats">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="cat" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="cat__img">
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- elsif c.featured_image -%}{{ c.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: c.title }}
            {%- else -%}<img src="{{ block.settings.fallback | append: '.webp' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy" width="400" height="300">{%- endif -%}
          </div>
          <div class="cat__bar"><span>{{ block.settings.title | default: c.title }}</span>{% render 'icon', name: 'arrow' %}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shop by category",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" }],
  "blocks": [{ "type": "cat", "name": "Category", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "select", "id": "fallback", "label": "Placeholder image", "default": "z-cat-tshirts", "options": [
      { "value": "z-cat-tshirts", "label": "T-Shirts" }, { "value": "z-cat-oversized", "label": "Oversized" }, { "value": "z-cat-polos", "label": "Polos" },
      { "value": "z-cat-hoodies", "label": "Hoodies" }, { "value": "z-cat-bottomwear", "label": "Bottomwear" }, { "value": "z-cat-accessories", "label": "Accessories" }
    ] }
  ] }],
  "presets": [{ "name": "Shop by category" }]
}
{% endschema %}
