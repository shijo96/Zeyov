{%- paginate collection.products by section.settings.per_page -%}
<section class="section collection-page">
  <div class="container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Collections</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="cur" aria-current="page">{{ collection.title }}</span>
    </nav>

    <!-- Collection Editorial Header -->
    <header class="section__head collection-head center">
      <span class="eyebrow">ZEYOV ATELIER &bull; READY-TO-WEAR</span>
      <h1 class="collection-title">{{ collection.title }}</h1>
      <div class="collection-desc rte muted">
        {%- if collection.description != blank -%}
          {{ collection.description }}
        {%- else -%}
          <p>Precision-tailored garments, sculpted silhouettes, and handcrafted luxury accessories designed for modern distinction.</p>
        {%- endif -%}
      </div>

      <!-- Quick Category Navigation Pills -->
      <div class="collection-nav-pills" role="navigation" aria-label="Collection Categories">
        <a href="{{ routes.all_products_collection_url }}" class="cat-pill{% if collection.handle == 'all' or collection.handle == blank %} is-active{% endif %}">
          All Creations
        </a>
        <a href="{{ routes.root_url }}#FashionShowcase" class="cat-pill">
          Dresses &amp; Gowns
        </a>
        <a href="{{ routes.root_url }}#FashionShowcase" class="cat-pill">
          Outerwear &amp; Jackets
        </a>
        <a href="{{ routes.collections_url }}/accessories" class="cat-pill{% if collection.handle == 'accessories' %} is-active{% endif %}">
          Fashion Accessories
        </a>
        <a href="{{ routes.root_url }}#RunwayOrbit" class="cat-pill">
          The Runway Edit
        </a>
      </div>
    </header>

    <!-- Collection Toolbar -->
    <div class="collection-toolbar">
      <div class="toolbar__count">
        <span class="toolbar__count-num">{{ collection.products_count }}</span>
        <span class="toolbar__count-text">Piece{% if collection.products_count != 1 %}s{% endif %} available</span>
      </div>

      <div class="toolbar__sort-wrap">
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <label for="CollectionSort" class="sort-label">Sort By</label>
        <div class="sort-select-box">
          <select id="CollectionSort" class="sort-select" onchange="location.href='?sort_by='+this.value">
            <option value="manual" {% if sort_by == 'manual' %}selected{% endif %}>Featured Runway</option>
            <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest Additions</option>
          </select>
          <span class="sort-chevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </span>
        </div>
      </div>
    </div>

    <!-- Online Store 2.0 Facets & Filtering Form -->
    {%- assign total_active_filters = 0 -%}
    {%- for filter in collection.filters -%}
      {%- assign total_active_filters = total_active_filters | plus: filter.active_values.size -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
          {%- assign total_active_filters = total_active_filters | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if collection.filters.size > 0 -%}
      <div class="collection-facets-wrap" id="CollectionFacets">
        <div class="facets__header">
          <h3 class="facets__title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
            Refine &amp; Filter Collection
          </h3>
          <div class="facets__summary-bar">
            <span>Showing {{ collection.products_count }} item{% if collection.products_count != 1 %}s{% endif %}</span>
            {%- if total_active_filters > 0 -%}
              <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="active-filters__clear-all">Reset All Filters ({{ total_active_filters }})</a>
            {%- endif -%}
          </div>
        </div>

        <form class="facets__form" id="FacetFiltersForm" method="get" action="{{ collection.url }}">
          <input type="hidden" name="sort_by" value="{{ sort_by }}">

          {%- for filter in collection.filters -%}
            <div class="facet-group">
              <span class="facet-group__title">{{ filter.label }}</span>
              {%- case filter.type -%}
                {%- when 'list' -%}
                  <ul class="facet-group__list">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="facet-checkbox-label">
                          <input type="checkbox"
                                 name="{{ value.param_name }}"
                                 value="{{ value.value }}"
                                 id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                                 {% if value.active %}checked{% endif %}
                                 {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                 onchange="this.closest('form').submit();">
                          <span>{{ value.label }}</span>
                          <span class="facet-checkbox-count">({{ value.count }})</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="facet-price-range">
                    <div class="facet-price-input-wrap">
                      <span class="facet-price-currency">{{ cart.currency.symbol }}</span>
                      <input class="facet-price-input"
                             name="{{ filter.min_value.param_name }}"
                             id="Filter-{{ filter.min_value.param_name }}"
                             {%- if filter.min_value.value -%}
                               value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                             {%- endif -%}
                             type="number"
                             placeholder="Min"
                             min="0"
                             max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
                    </div>
                    <span class="facet-price-sep">&ndash;</span>
                    <div class="facet-price-input-wrap">
                      <span class="facet-price-currency">{{ cart.currency.symbol }}</span>
                      <input class="facet-price-input"
                             name="{{ filter.max_value.param_name }}"
                             id="Filter-{{ filter.max_value.param_name }}"
                             {%- if filter.max_value.value -%}
                               value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                             {%- endif -%}
                             type="number"
                             placeholder="Max"
                             min="0"
                             max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
                    </div>
                    <button type="submit" class="facet-price-apply" aria-label="Apply price filter">Go</button>
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </form>

        {%- if total_active_filters > 0 -%}
          <div class="active-filters">
            <span style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);font-weight:600">Active Filters:</span>
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <a href="{{ value.url_to_remove }}" class="active-filter-chip">
                  <span>{{ filter.label }}: {{ value.label }}</span>
                  <span class="active-filter-chip__remove" aria-hidden="true">&times;</span>
                </a>
              {%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                  <a href="{{ filter.url_to_remove }}" class="active-filter-chip">
                    <span>
                      {{ cart.currency.symbol }}{{ filter.min_value.value | default: 0 | money_without_currency }} &ndash;
                      {{ cart.currency.symbol }}{{ filter.max_value.value | default: filter.range_max | money_without_currency }}
                    </span>
                    <span class="active-filter-chip__remove" aria-hidden="true">&times;</span>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="active-filters__clear-all">Clear All</a>
          </div>
        {%- endif -%}
      </div>
    {%- elsif collection.all_tags.size > 0 -%}
      <!-- Fallback Tag Filtering when OS 2.0 Facets are not configured yet in Shopify Admin -->
      <div class="collection-facets-wrap" id="CollectionTagFilters">
        <div class="facets__header">
          <h3 class="facets__title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
            Filter by Department &amp; Style
          </h3>
          <div class="facets__summary-bar">
            <span>Showing {{ collection.products_count }} item{% if collection.products_count != 1 %}s{% endif %}</span>
            {%- if current_tags -%}
              <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="active-filters__clear-all">Clear Filter</a>
            {%- endif -%}
          </div>
        </div>
        <div class="active-filters" style="border:none;margin:0;padding-top:14px">
          {%- for tag in collection.all_tags -%}
            {%- if current_tags contains tag -%}
              <span class="active-filter-chip" style="background:var(--gold-dark);color:#fff">
                {{ tag }}
                <a href="{{ collection.url }}" style="color:#fff;margin-left:4px;text-decoration:none">&times;</a>
              </span>
            {%- else -%}
              <a href="{{ collection.url }}/{{ tag | handleize }}?sort_by={{ sort_by }}" class="active-filter-chip">
                + {{ tag }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Product Grid -->
    <div class="grid grid--products grid--fashion-catalog">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="empty-state" style="grid-column:1/-1;text-align:center;padding:60px 20px">
          <p class="muted" style="margin-bottom:20px">The couture pieces for this curation are currently being prepared.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn">Explore All Creations</a>
        </div>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "Collection",
  "settings": [{ "type": "range", "id": "per_page", "min": 5, "max": 50, "step": 5, "label": "Products per page", "default": 15 }]
}
{% endschema %}
