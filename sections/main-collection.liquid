{%- paginate collection.products by section.settings.per_page -%}
<section class="section collection-page">
  <div class="container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Collections</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="cur" aria-current="page">{{ collection.title }}</span>
    </nav>

    <!-- Collection Editorial Header -->
    <header class="section__head collection-head center">
      <span class="eyebrow">ZEYOV ATELIER &bull; READY-TO-WEAR</span>
      <h1 class="collection-title">{{ collection.title }}</h1>
      <div class="collection-desc rte muted">
        {%- if collection.description != blank -%}
          {{ collection.description }}
        {%- else -%}
          <p>Precision-tailored garments, sculpted silhouettes, and handcrafted luxury accessories designed for modern distinction.</p>
        {%- endif -%}
      </div>

      <!-- Quick Category Navigation Pills -->
      <div class="collection-nav-pills" role="navigation" aria-label="Collection Categories">
        <a href="{{ routes.all_products_collection_url }}" class="cat-pill{% if collection.handle == 'all' or collection.handle == blank %} is-active{% endif %}">
          All Creations
        </a>
        <a href="{{ routes.root_url }}#FashionShowcase" class="cat-pill">
          Dresses &amp; Gowns
        </a>
        <a href="{{ routes.root_url }}#FashionShowcase" class="cat-pill">
          Outerwear &amp; Jackets
        </a>
        <a href="{{ routes.collections_url }}/accessories" class="cat-pill{% if collection.handle == 'accessories' %} is-active{% endif %}">
          Fashion Accessories
        </a>
        <a href="{{ routes.root_url }}#RunwayOrbit" class="cat-pill">
          The Runway Edit
        </a>
      </div>
    </header>

    <!-- Collection Toolbar -->
    <div class="collection-toolbar">
      <div class="toolbar__count">
        <span class="toolbar__count-num">{{ collection.products_count }}</span>
        <span class="toolbar__count-text">Piece{% if collection.products_count != 1 %}s{% endif %} available</span>
      </div>

      <div class="toolbar__sort-wrap">
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <label for="CollectionSort" class="sort-label">Sort By</label>
        <div class="sort-select-box">
          <select id="CollectionSort" class="sort-select" onchange="location.href='?sort_by='+this.value">
            <option value="manual" {% if sort_by == 'manual' %}selected{% endif %}>Featured Runway</option>
            <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
            <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
            <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest Additions</option>
          </select>
          <span class="sort-chevron" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </span>
        </div>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid--products grid--fashion-catalog">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="empty-state" style="grid-column:1/-1;text-align:center;padding:60px 20px">
          <p class="muted" style="margin-bottom:20px">The couture pieces for this curation are currently being prepared.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn">Explore All Creations</a>
        </div>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "Collection",
  "settings": [{ "type": "range", "id": "per_page", "min": 4, "max": 48, "step": 4, "label": "Products per page", "default": 12 }]
}
{% endschema %}
