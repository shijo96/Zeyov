{%- paginate collection.products by section.settings.per_page -%}
<section class="section collection-page">
  <div class="container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Collections</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="cur" aria-current="page">{{ collection.title }}</span>
    </nav>

    {%- comment -%} Determine Active Department for Tab Highlighting (Myntra App Architecture) {%- endcomment -%}
    {%- assign col_h = collection.handle | default: '' -%}
    {%- assign active_dept = 'all' -%}
    {%- if col_h contains 'men' and col_h contains 'women' == false -%}
      {%- assign active_dept = 'men' -%}
    {%- elsif col_h contains 'kid' or col_h contains 'baby' -%}
      {%- assign active_dept = 'kids' -%}
    {%- elsif col_h contains 'women' or col_h == 'western-wear' or col_h contains 'dress' or col_h contains 'coord' -%}
      {%- assign active_dept = 'women' -%}
    {%- endif -%}

    <!-- Myntra-Style Department Tab Switcher (ALL | WOMEN | MEN | KIDS) -->
    <div class="myntra-dept-tabs" role="tablist" aria-label="Department Selection">
      <a href="{{ routes.all_products_collection_url }}" class="dept-tab{% if active_dept == 'all' %} is-active{% endif %}" role="tab" aria-selected="{% if active_dept == 'all' %}true{% else %}false{% endif %}">
        <span>ALL</span>
      </a>
      <a href="{{ routes.collections_url }}/womens-wear" class="dept-tab{% if active_dept == 'women' %} is-active{% endif %}" role="tab" aria-selected="{% if active_dept == 'women' %}true{% else %}false{% endif %}">
        <span>WOMEN</span>
      </a>
      <a href="{{ routes.collections_url }}/mens-wear" class="dept-tab{% if active_dept == 'men' %} is-active{% endif %}" role="tab" aria-selected="{% if active_dept == 'men' %}true{% else %}false{% endif %}">
        <span>MEN</span>
      </a>
      <a href="{{ routes.collections_url }}/kidswear" class="dept-tab{% if active_dept == 'kids' %} is-active{% endif %}" role="tab" aria-selected="{% if active_dept == 'kids' %}true{% else %}false{% endif %}">
        <span>KIDS</span>
      </a>
    </div>

    <!-- Myntra-Style Visual Micro-Categories Horizontal Track (Thumbnails + Names) -->
    <div class="myntra-circle-rail-wrap">
      <div class="myntra-circle-rail">
        {%- if active_dept == 'men' -%}
          <a href="{{ routes.collections_url }}/mens-wear" class="circle-item{% if col_h == 'mens-wear' or col_h == 'mens-collection' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'fashion-model-editorial.jpg' | asset_url }}" alt="All Men" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">All Men</span>
          </a>
          <a href="{{ routes.collections_url }}/mens-tshirts" class="circle-item{% if col_h == 'mens-tshirts' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'cat-festive.jpg' | asset_url }}" alt="T-Shirts" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">T-Shirts</span>
          </a>
          <a href="{{ routes.collections_url }}/mens-shirts" class="circle-item{% if col_h == 'mens-shirts' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'collection-runway.jpg' | asset_url }}" alt="Shirts" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Shirts</span>
          </a>
          <a href="{{ routes.collections_url }}/mens-trousers" class="circle-item{% if col_h == 'mens-trousers' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'fashion-wool-coat.jpg' | asset_url }}" alt="Trousers" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Trousers</span>
          </a>
          <a href="{{ routes.collections_url }}/mens-casual-wear" class="circle-item{% if col_h == 'mens-casual-wear' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'fashion-sherpa-jacket.jpg' | asset_url }}" alt="Jackets" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Jackets</span>
          </a>
          <a href="{{ routes.collections_url }}/mens-accessories" class="circle-item{% if col_h == 'mens-accessories' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'cat-accessories.jpg' | asset_url }}" alt="Accessories" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Accessories</span>
          </a>
        {%- elsif active_dept == 'kids' -%}
          <a href="{{ routes.collections_url }}/kidswear" class="circle-item{% if col_h == 'kidswear' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'cat-kidswear.jpg' | asset_url }}" alt="All Kids" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">All Kids</span>
          </a>
          <a href="{{ routes.collections_url }}/baby-winterwear" class="circle-item{% if col_h == 'baby-winterwear' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'cat-baby.jpg' | asset_url }}" alt="Baby Wear" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Baby Wear</span>
          </a>
          <a href="{{ routes.collections_url }}/new-arrivals" class="circle-item">
            <div class="circle-item__bubble">
              <img src="{{ 'cat-coords.jpg' | asset_url }}" alt="New Drops" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">New Drops</span>
          </a>
        {%- else -%}
          <a href="{{ routes.collections_url }}/womens-wear" class="circle-item{% if col_h == 'womens-wear' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'fashion-silk-dress.jpg' | asset_url }}" alt="All Women" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">All Women</span>
          </a>
          <a href="{{ routes.collections_url }}/womens-dresses" class="circle-item{% if col_h == 'womens-dresses' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'cat-coords.jpg' | asset_url }}" alt="Dresses" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Dresses</span>
          </a>
          <a href="{{ routes.collections_url }}/western-wear" class="circle-item{% if col_h == 'western-wear' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'collection-runway.jpg' | asset_url }}" alt="Western" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Western</span>
          </a>
          <a href="{{ routes.collections_url }}/womens-tops-tshirts" class="circle-item{% if col_h == 'womens-tops-tshirts' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'cat-festive.jpg' | asset_url }}" alt="Tops & Tees" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Tops &amp; Tees</span>
          </a>
          <a href="{{ routes.collections_url }}/womens-bottomwear" class="circle-item{% if col_h == 'womens-bottomwear' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'fashion-wool-coat.jpg' | asset_url }}" alt="Bottomwear" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Bottomwear</span>
          </a>
          <a href="{{ routes.collections_url }}/womens-winter-wear" class="circle-item{% if col_h == 'womens-winter-wear' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'fashion-sherpa-jacket.jpg' | asset_url }}" alt="Winter Wear" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Winter Wear</span>
          </a>
          <a href="{{ routes.collections_url }}/accessories" class="circle-item{% if col_h == 'accessories' or col_h == 'womens-accessories' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'cat-accessories.jpg' | asset_url }}" alt="Accessories" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">Accessories</span>
          </a>
          <a href="{{ routes.collections_url }}/new-arrivals" class="circle-item{% if col_h == 'new-arrivals' %} is-active{% endif %}">
            <div class="circle-item__bubble">
              <img src="{{ 'fashion-model-dress.jpg' | asset_url }}" alt="New In" width="68" height="68" loading="eager">
            </div>
            <span class="circle-item__label">New In</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Collection Editorial Header (Clean & Compact on Mobile) -->
    <header class="section__head collection-head">
      <div class="collection-title-row">
        <h1 class="collection-title">
          <span>{{ collection.title }}</span>
          <span class="title-count">({{ collection.products_count | default: 0 }} pieces)</span>
        </h1>
      </div>
      <div class="collection-desc rte muted desktop-only">
        {%- if collection.description != blank -%}
          {{ collection.description }}
        {%- else -%}
          <p>Precision-tailored garments, sculpted silhouettes, and handcrafted luxury accessories designed for modern distinction.</p>
        {%- endif -%}
      </div>

      <!-- Horizontal Scrollable Category Capsule Pills (Never Wraps on Mobile) -->
      <div class="collection-nav-pills" role="navigation" aria-label="Collection Categories">
        <a href="{{ routes.all_products_collection_url }}" class="cat-pill{% if collection.handle == 'all' or collection.handle == blank %} is-active{% endif %}">
          All Pieces
        </a>
        <a href="{{ routes.collections_url }}/new-arrivals" class="cat-pill{% if collection.handle == 'new-arrivals' %} is-active{% endif %}">
          New Arrivals
        </a>
        {%- if active_dept == 'men' -%}
          <a href="{{ routes.collections_url }}/mens-wear" class="cat-pill{% if collection.handle == 'mens-wear' or collection.handle == 'mens-collection' %} is-active{% endif %}">
            All Men's
          </a>
          <a href="{{ routes.collections_url }}/mens-tshirts" class="cat-pill{% if collection.handle == 'mens-tshirts' %} is-active{% endif %}">
            T-Shirts &amp; Polos
          </a>
          <a href="{{ routes.collections_url }}/mens-shirts" class="cat-pill{% if collection.handle == 'mens-shirts' %} is-active{% endif %}">
            Shirts
          </a>
          <a href="{{ routes.collections_url }}/mens-trousers" class="cat-pill{% if collection.handle == 'mens-trousers' %} is-active{% endif %}">
            Trousers &amp; Chinos
          </a>
          <a href="{{ routes.collections_url }}/mens-casual-wear" class="cat-pill{% if collection.handle == 'mens-casual-wear' %} is-active{% endif %}">
            Jackets &amp; Vests
          </a>
          <a href="{{ routes.collections_url }}/mens-accessories" class="cat-pill{% if collection.handle == 'mens-accessories' %} is-active{% endif %}">
            Accessories
          </a>
        {%- elsif active_dept == 'kids' -%}
          <a href="{{ routes.collections_url }}/kidswear" class="cat-pill{% if collection.handle == 'kidswear' %} is-active{% endif %}">
            All Kidswear
          </a>
          <a href="{{ routes.collections_url }}/baby-winterwear" class="cat-pill{% if collection.handle == 'baby-winterwear' %} is-active{% endif %}">
            Baby Winterwear
          </a>
        {%- else -%}
          <a href="{{ routes.collections_url }}/womens-wear" class="cat-pill{% if collection.handle == 'womens-wear' %} is-active{% endif %}">
            Women's Edit
          </a>
          <a href="{{ routes.collections_url }}/western-wear" class="cat-pill{% if collection.handle == 'western-wear' %} is-active{% endif %}">
            Western Wear
          </a>
          <a href="{{ routes.collections_url }}/womens-dresses" class="cat-pill{% if collection.handle == 'womens-dresses' %} is-active{% endif %}">
            Dresses &amp; Gowns
          </a>
          <a href="{{ routes.collections_url }}/womens-tops-tshirts" class="cat-pill{% if collection.handle == 'womens-tops-tshirts' %} is-active{% endif %}">
            Tops &amp; Tees
          </a>
          <a href="{{ routes.collections_url }}/womens-bottomwear" class="cat-pill{% if collection.handle == 'womens-bottomwear' %} is-active{% endif %}">
            Bottomwear
          </a>
          <a href="{{ routes.collections_url }}/womens-winter-wear" class="cat-pill{% if collection.handle == 'womens-winter-wear' %} is-active{% endif %}">
            Winter Wear
          </a>
          <a href="{{ routes.collections_url }}/accessories" class="cat-pill{% if collection.handle == 'accessories' or collection.handle == 'womens-accessories' %} is-active{% endif %}">
            Accessories
          </a>
        {%- endif -%}
      </div>
    </header>

    <!-- Collection Toolbar -->
    <div class="collection-toolbar">
      <div class="toolbar__count">
        <span class="toolbar__count-num">{{ collection.products_count }}</span>
        <span class="toolbar__count-text">Piece{% if collection.products_count != 1 %}s{% endif %} available</span>
      </div>

      <div class="toolbar__actions-wrap">
        {%- if collection.filters.size > 0 or collection.all_tags.size > 0 -%}
          <button type="button" class="btn btn--small btn--outline mobile-filter-btn" data-open-filters aria-label="Open Filters">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
            <span>Filters</span>
            {%- if total_active_filters > 0 -%}
              <span class="active-filter-badge">{{ total_active_filters }}</span>
            {%- endif -%}
          </button>
        {%- endif -%}

        <div class="toolbar__sort-wrap">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <label for="CollectionSort" class="sort-label">Sort By</label>
          <div class="sort-select-box">
            <select id="CollectionSort" class="sort-select" onchange="location.href='?sort_by='+this.value">
              <option value="manual" {% if sort_by == 'manual' %}selected{% endif %}>Featured Runway</option>
              <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
              <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
              <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
              <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest Additions</option>
            </select>
            <span class="sort-chevron" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Online Store 2.0 Facets & Filtering Form (Bottom Sheet on Mobile) -->
    <div class="filters-backdrop" data-close-filters></div>
    {%- if collection.filters.size > 0 -%}
      <div class="collection-facets-wrap" id="CollectionFacets">
        <div class="facets__header">
          <h3 class="facets__title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
            Refine &amp; Filter Collection
          </h3>
          <div class="facets__summary-bar">
            <span>Showing {{ collection.products_count }} item{% if collection.products_count != 1 %}s{% endif %}</span>
            {%- if total_active_filters > 0 -%}
              <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="active-filters__clear-all">Reset All ({{ total_active_filters }})</a>
            {%- endif -%}
            <button type="button" class="icon-btn facets__close-btn" data-close-filters aria-label="Close filters">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
        </div>

        <form class="facets__form" id="FacetFiltersForm" method="get" action="{{ collection.url }}">
          <input type="hidden" name="sort_by" value="{{ sort_by }}">

          {%- for filter in collection.filters -%}
            <div class="facet-group">
              <span class="facet-group__title">{{ filter.label }}</span>
              {%- case filter.type -%}
                {%- when 'list' -%}
                  <ul class="facet-group__list">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="facet-checkbox-label">
                          <input type="checkbox"
                                 name="{{ value.param_name }}"
                                 value="{{ value.value }}"
                                 id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                                 {% if value.active %}checked{% endif %}
                                 {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                 onchange="this.closest('form').submit();">
                          <span>{{ value.label }}</span>
                          <span class="facet-checkbox-count">({{ value.count }})</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="facet-price-range">
                    <div class="facet-price-input-wrap">
                      <span class="facet-price-currency">{{ cart.currency.symbol }}</span>
                      <input class="facet-price-input"
                             name="{{ filter.min_value.param_name }}"
                             id="Filter-{{ filter.min_value.param_name }}"
                             {%- if filter.min_value.value -%}
                               value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                             {%- endif -%}
                             type="number"
                             placeholder="Min"
                             min="0"
                             max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
                    </div>
                    <span class="facet-price-sep">&ndash;</span>
                    <div class="facet-price-input-wrap">
                      <span class="facet-price-currency">{{ cart.currency.symbol }}</span>
                      <input class="facet-price-input"
                             name="{{ filter.max_value.param_name }}"
                             id="Filter-{{ filter.max_value.param_name }}"
                             {%- if filter.max_value.value -%}
                               value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                             {%- endif -%}
                             type="number"
                             placeholder="Max"
                             min="0"
                             max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
                    </div>
                    <button type="submit" class="facet-price-apply" aria-label="Apply price filter">Go</button>
                  </div>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </form>

        {%- if total_active_filters > 0 -%}
          <div class="active-filters">
            <span style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);font-weight:600">Active Filters:</span>
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <a href="{{ value.url_to_remove }}" class="active-filter-chip">
                  <span>{{ filter.label }}: {{ value.label }}</span>
                  <span class="active-filter-chip__remove" aria-hidden="true">&times;</span>
                </a>
              {%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                  <a href="{{ filter.url_to_remove }}" class="active-filter-chip">
                    <span>
                      {{ cart.currency.symbol }}{{ filter.min_value.value | default: 0 | money_without_currency }} &ndash;
                      {{ cart.currency.symbol }}{{ filter.max_value.value | default: filter.range_max | money_without_currency }}
                    </span>
                    <span class="active-filter-chip__remove" aria-hidden="true">&times;</span>
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="active-filters__clear-all">Clear All</a>
          </div>
        {%- endif -%}
      </div>
    {%- elsif collection.all_tags.size > 0 -%}
      <!-- Fallback Tag Filtering when OS 2.0 Facets are not configured yet in Shopify Admin -->
      <div class="collection-facets-wrap" id="CollectionTagFilters">
        <div class="facets__header">
          <h3 class="facets__title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
            Filter by Department &amp; Style
          </h3>
          <div class="facets__summary-bar">
            <span>Showing {{ collection.products_count }} item{% if collection.products_count != 1 %}s{% endif %}</span>
            {%- if current_tags -%}
              <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="active-filters__clear-all">Clear Filter</a>
            {%- endif -%}
          </div>
        </div>
        <div class="active-filters" style="border:none;margin:0;padding-top:14px">
          {%- for tag in collection.all_tags -%}
            {%- if current_tags contains tag -%}
              <span class="active-filter-chip" style="background:var(--gold-dark);color:#fff">
                {{ tag }}
                <a href="{{ collection.url }}" style="color:#fff;margin-left:4px;text-decoration:none">&times;</a>
              </span>
            {%- else -%}
              <a href="{{ collection.url }}/{{ tag | handleize }}?sort_by={{ sort_by }}" class="active-filter-chip">
                + {{ tag }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <!-- Product Grid -->
    <div class="grid grid--products grid--fashion-catalog">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="empty-state" style="grid-column:1/-1;text-align:center;padding:40px 20px 20px">
          <span class="badge badge--gold mb-xs">ATELIER DROP IN PREPARATION</span>
          <h2 style="font-family:var(--font-heading);font-size:1.4rem;margin:8px 0 10px;">The {{ collection.title }} Capsule Is Being Curated</h2>
          <p class="muted" style="max-width:540px;margin:0 auto 18px;font-size:0.92rem;">
            Our designers are currently hand-finishing the next limited pieces for this curation. In the meantime, explore our signature creations below or inquire for bespoke sizing on WhatsApp.
          </p>
          {%- if settings.whatsapp_number != blank -%}
            {%- assign wa_num = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' -%}
            <a class="btn btn--small btn--gold" href="https://wa.me/{{ wa_num }}?text=Hi%20Zeyov%20Atelier%2C%20I%20would%20like%20to%20inquire%20about%20{{ collection.title | url_encode }}" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:6px;">
              {% render 'icon', name: 'whatsapp' %} Inquire on WhatsApp
            </a>
          {%- endif -%}
        </div>

        {%- assign all_creations = collections.all.products -%}
        {%- if all_creations.size > 0 -%}
          {%- for prod in all_creations limit: 8 -%}
            {% render 'product-card', product: prod %}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "Collection",
  "settings": [{ "type": "range", "id": "per_page", "min": 5, "max": 50, "step": 5, "label": "Products per page", "default": 15 }]
}
{% endschema %}
