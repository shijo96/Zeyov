<div class="wrap">
  <div class="pagehead"><span class="eyebrow">We're here to help</span><h1>{{ page.title }}</h1><p class="muted">Questions about orders, sizes, Zeyov Studio or replacements? Reach us any way you like.</p></div>
  <div class="contact">
    <div class="contact__cards">
      {%- if settings.whatsapp_number != blank -%}<a class="ccard ccard--wa" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener"><span>{% render 'icon', name: 'whatsapp' %}</span><b>WhatsApp</b><small>Fastest reply</small></a>{%- endif -%}
      {%- if settings.contact_phone != blank -%}<a class="ccard" href="tel:{{ settings.contact_phone | remove: ' ' }}"><span>{% render 'icon', name: 'phone' %}</span><b>Call us</b><small>{{ settings.contact_phone }}</small></a>{%- endif -%}
      {%- if settings.contact_email != blank -%}<a class="ccard" href="mailto:{{ settings.contact_email }}"><span>{% render 'icon', name: 'mail' %}</span><b>Email</b><small>{{ settings.contact_email }}</small></a>{%- endif -%}
      <div class="ccard"><span>{% render 'icon', name: 'clock' %}</span><b>Support hours</b><small>{{ settings.contact_hours }}</small></div>
    </div>
    <div class="contact__form step">
      <h2 style="font:600 20px/1.3 var(--font-body)">Send us a message</h2>
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}<p class="notice">Thanks! We've received your message and will reply within 24 hours.</p>{%- endif -%}
        {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="form-grid">
          <div class="form-row"><label for="cf-name">Name</label><input class="input" id="cf-name" name="contact[name]" autocomplete="name" required value="{% if customer %}{{ customer.name }}{% endif %}"></div>
          <div class="form-row"><label for="cf-phone">Phone</label><input class="input" id="cf-phone" name="contact[phone]" type="tel" autocomplete="tel" required></div>
        </div>
        <div class="form-row"><label for="cf-email">Email</label><input class="input" id="cf-email" name="contact[email]" type="email" autocomplete="email" required value="{% if customer %}{{ customer.email }}{% endif %}"></div>
        <div class="form-row"><label for="cf-order">Order number (optional)</label><input class="input" id="cf-order" name="contact[Order number]" placeholder="#1001"></div>
        <div class="form-row"><label for="cf-msg">Message</label><textarea class="input" id="cf-msg" name="contact[body]" required></textarea></div>
        <button class="btn btn--block" type="submit">Send message</button>
      {%- endform -%}
    </div>
  </div>
  {%- if page.content != blank -%}<div class="rte page-body">{{ page.content }}</div>{%- endif -%}
</div>
{% schema %}
{ "name": "Contact page" }
{% endschema %}
