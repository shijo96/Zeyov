<div class="wrap" style="padding-bottom:60px">
  <div class="coll-hero"><span class="eyebrow">Browse</span><h1>Collections</h1></div>
  <div class="grid grid--4">
    {%- for c in collections -%}
      {%- unless c.handle == 'frontpage' -%}
      <a class="tile" href="{{ c.url }}">
        <div class="tile__img">{%- if c.featured_image -%}{{ c.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: c.title }}{%- else -%}<img src="{{ 'oversized-tee-250-gsm-french-terry-black.webp' | asset_url }}" alt="" loading="lazy">{%- endif -%}</div>
        <div><h3>{{ c.title }}</h3><span>{{ c.products_count }} products</span></div>
      </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>
{% schema %}
{ "name": "Collections list" }
{% endschema %}
