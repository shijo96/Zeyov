{%- comment -%}
  Testimonials: add real customer quotes as blocks, or add a review app's carousel block
  (e.g. Judge.me "Reviews carousel") to show live reviews. Nothing is shown to visitors
  until at least one block is added.
{%- endcomment -%}
{%- assign quotes = 0 -%}{%- assign apps = 0 -%}
{%- for block in section.blocks -%}{%- if block.type == '@app' -%}{%- assign apps = apps | plus: 1 -%}{%- elsif block.settings.quote != blank -%}{%- assign quotes = quotes | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if quotes > 0 or apps > 0 or request.design_mode -%}
<section class="section tm">
  <div class="wrap">
    <div class="section-head">
      <div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
      {%- if section.settings.link != blank -%}<a class="link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }} →</a>{%- endif -%}
    </div>

    {%- if quotes == 0 and apps == 0 -%}
      <p class="tm__hint">Add a <b>Testimonial</b> block for each real customer quote, or add your review app's carousel block. This section stays hidden from visitors until you do.</p>
    {%- endif -%}

    {%- for block in section.blocks -%}{%- if block.type == '@app' -%}<div class="tm__app" {{ block.shopify_attributes }}>{% render block %}</div>{%- endif -%}{%- endfor -%}

    {%- if quotes > 0 -%}
      <div class="quotes tm__quotes">
        {%- for block in section.blocks -%}
          {%- if block.type == 'quote' and block.settings.quote != blank -%}
            <figure class="quote tm__card" {{ block.shopify_attributes }}>
              <span class="stars"><span class="stars__row" style="--pct: {{ block.settings.rating | times: 20 }}%"></span></span>
              <blockquote>“{{ block.settings.quote }}”</blockquote>
              {%- if block.settings.photo != blank -%}
                {{ block.settings.photo | image_url: width: 400 | image_tag: class: 'tm__photo', loading: 'lazy', widths: '200, 400', sizes: '120px', alt: block.settings.name }}
              {%- endif -%}
              <footer>
                <span class="tm__who"><b>{{ block.settings.name }}</b>{%- if block.settings.place != blank -%}<span>{{ block.settings.place }}</span>{%- endif -%}</span>
                <span class="tm__meta">{%- if block.settings.verified -%}<span class="verified">✓ Verified buyer</span>{%- endif -%}{%- if block.settings.product != blank -%}<span>{{ block.settings.product }}</span>{%- endif -%}</span>
              </footer>
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small title", "default": "Customer love" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn and reviewed" },
    { "type": "url", "id": "link", "label": "Link (optional)", "info": "e.g. your Google reviews page" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "See all reviews" },
    { "type": "paragraph", "content": "Use only real customer reviews. The section is hidden until you add a testimonial or a review-app block." }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "quote", "name": "Testimonial", "settings": [
      { "type": "textarea", "id": "quote", "label": "Customer's words" },
      { "type": "text", "id": "name", "label": "Name", "info": "First name and initial, e.g. Arun K." },
      { "type": "text", "id": "place", "label": "City" },
      { "type": "text", "id": "product", "label": "Product bought" },
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true },
      { "type": "image_picker", "id": "photo", "label": "Customer photo (optional)" }
    ] }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
