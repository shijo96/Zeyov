<section class="section">
  <div class="wrap">
    <div class="section-head"><div><span class="eyebrow">Reviews</span><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="quotes">
      {%- for block in section.blocks -%}
        <figure class="quote" {{ block.shopify_attributes }}>
          <span class="stars"><span class="stars__row" style="--pct: {{ block.settings.rating | times: 20 }}%"></span></span>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <footer><span>{{ block.settings.name }}</span><span>{{ block.settings.product }}</span></footer>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Testimonials",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Worn and reviewed" }],
  "blocks": [{ "type": "quote", "name": "Quote", "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "text", "id": "name", "label": "Name" },
    { "type": "text", "id": "product", "label": "Product" },
    { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 }
  ] }],
  "presets": [{ "name": "Testimonials", "blocks": [
    { "type": "quote", "settings": { "quote": "The 250 GSM black is thick, the drop shoulder sits right, and the collar is still tight after ten washes.", "name": "Arjun M., Kochi", "product": "Oversized 250 GSM", "rating": 5 } },
    { "type": "quote", "settings": { "quote": "Bought three colours to get the bundle price. Lavender is my favourite, true to the photos.", "name": "Fathima R., Calicut", "product": "Oversized 250 GSM", "rating": 5 } },
    { "type": "quote", "settings": { "quote": "Acid wash pattern is different on every piece. Fast delivery and COD made it easy.", "name": "Nikhil S., Bengaluru", "product": "Acid Wash Oversized", "rating": 4 } }
  ] }]
}
{% endschema %}
