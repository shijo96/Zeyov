<section class="section" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">Complete the bundle</span><h2>{{ section.settings.heading }}</h2></div></div>
      <div class="grid grid--4">{%- for p in recommendations.products -%}{% render 'product-card', product: p %}{%- endfor -%}</div>
    </div>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Related products", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" }] }
{% endschema %}
