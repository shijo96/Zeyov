{%- assign p1 = section.settings.product_1 -%}
{%- assign p2 = section.settings.product_2 -%}
{%- if p1 == blank -%}{%- assign p1 = collections.all.products.first -%}{%- endif -%}
{%- if p2 == blank -%}{%- assign p2 = collections.all.products[1] -%}{%- endif -%}
<section class="hero" style="--hero-silk:url('{{ 'hero-silk.jpg' | asset_url }}');--hero-leaf:url('{{ 'hero-leaf.jpg' | asset_url }}')">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      <p class="hero__sub">{{ section.settings.subheading }}</p>
      <div class="hero__cta">
        {%- if section.settings.btn_label != blank -%}<a class="btn btn--gold" href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}">{{ section.settings.btn_label }}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="btn btn--ghost" href="{{ section.settings.btn2_link | default: routes.all_products_collection_url }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
      <ul class="hero__points" role="list">
        {%- for i in (1..3) -%}
          {%- assign key = 'point_' | append: i -%}
          {%- if section.settings[key] != blank -%}<li>{% render 'icon', name: 'check' %}{{ section.settings[key] }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <div class="hero__products">
      {% render 'hero-card', p: p1, index: 1 %}
      {% render 'hero-card', p: p2, index: 2 %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fashion | Lifestyle | Everyday Essentials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Style for a Brighter You" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Thoughtfully picked everyday essentials that make your home and routine feel a little more beautiful." },
    { "type": "text", "id": "btn_label", "label": "Button 1 label", "default": "Shop the collection" },
    { "type": "url", "id": "btn_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "Explore Bestsellers" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "Secure checkout" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Tracked delivery" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "Easy support" },
    { "type": "product", "id": "product_1", "label": "Hero product 1 (blank = first product)" },
    { "type": "product", "id": "product_2", "label": "Hero product 2 (blank = second product)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
