{%- comment -%}
  ZEYOV — Festival & Seasonal Marketing Campaign Banner
  Automated festive campaign display supporting Onam, Vishu, Diwali, Eid, Christmas & New Year drops.
{%- endcomment -%}

{%- if section.settings.enable_campaign -%}
<section class="section festival-banner festival-banner--{{ section.settings.theme_style }}" id="FestivalCampaignSection" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="festival-banner__card">
      <div class="festival-banner__content center">
        {%- if section.settings.badge_text != blank -%}
          <span class="badge badge--gold mb-xs">{{ section.settings.badge_text }}</span>
        {%- endif -%}

        <h2 class="festival-banner__title">{{ section.settings.heading | default: 'Special Festive Collection Drop' }}</h2>
        
        {%- if section.settings.subheading != blank -%}
          <p class="festival-banner__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.discount_code != blank -%}
          <div class="festival-banner__coupon-box">
            <span class="coupon-label">Use Code:</span>
            <button type="button" class="coupon-code-pill" data-copy-coupon="{{ section.settings.discount_code }}">
              <b>{{ section.settings.discount_code }}</b>
              <span class="coupon-copy-hint">Tap to Copy</span>
            </button>
            {%- if section.settings.discount_text != blank -%}
              <span class="coupon-desc">{{ section.settings.discount_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="festival-banner__actions">
          {%- if section.settings.button_link != blank and section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="btn btn--gold">
              {{ section.settings.button_label }} &rarr;
            </a>
          {%- endif -%}
          {%- if section.settings.enable_whatsapp_cta and settings.whatsapp_number != blank -%}
            {%- assign wa_phone = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' -%}
            {%- assign wa_msg = 'Hi Zeyov Atelier, I want to explore the ' | append: section.settings.heading | append: ' with code ' | append: section.settings.discount_code -%}
            <a href="https://wa.me/{{ wa_phone }}?text={{ wa_msg | url_encode }}" target="_blank" rel="noopener noreferrer" class="btn btn--outline" style="display:inline-flex;align-items:center;gap:6px;">
              {% render 'icon', name: 'whatsapp' %} <span>Claim On WhatsApp</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Festival Campaign Banner",
  "settings": [
    { "type": "checkbox", "id": "enable_campaign", "label": "Enable campaign banner", "default": true },
    { "type": "select", "id": "theme_style", "label": "Festive theme", "default": "luxury_gold", "options": [
      { "value": "luxury_gold", "label": "Luxury Gold & Espresso (All-Season)" },
      { "value": "onam", "label": "Onam Festive Edit (Kasavu Ivory & Gold)" },
      { "value": "vishu", "label": "Vishu Special (Kani Gold & Emerald)" },
      { "value": "diwali", "label": "Diwali Royal Edit (Warm Amber & Gold)" },
      { "value": "eid", "label": "Eid Collection (Emerald & Champagne)" },
      { "value": "christmas", "label": "Christmas & New Year (Deep Crimson & Noir)" },
      { "value": "clearance", "label": "End of Season Clearance" }
    ]},
    { "type": "text", "id": "badge_text", "label": "Festive badge", "default": "LIMITED FESTIVE DROP" },
    { "type": "text", "id": "heading", "label": "Campaign heading", "default": "Curated Festive Celebrations" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Bespoke silks and tailored silhouettes crafted for memorable occasions across India." },
    { "type": "text", "id": "discount_code", "label": "Promo / Discount code", "default": "FESTIVE10" },
    { "type": "text", "id": "discount_text", "label": "Discount description", "default": "Flat 10% Extra OFF on all Festive Orders" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Festive Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "enable_whatsapp_cta", "label": "Show WhatsApp claim button", "default": true }
  ],
  "presets": [
    { "name": "Festival Campaign Banner" }
  ]
}
{% endschema %}
