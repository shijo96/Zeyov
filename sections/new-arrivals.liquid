{%- liquid
  assign c = section.settings.collection
  if c == blank and collections['new-arrivals'].products_count > 0
    assign c = collections['new-arrivals']
  endif
  if c != blank
    assign items = c.products
    assign more_url = c.url
  else
    assign items = collections.all.products | sort: 'created_at' | reverse
    assign more_url = routes.all_products_collection_url | append: '?sort_by=created-descending'
  endif
-%}
<section class="section na" style="padding-block:26px 6px">
  <div class="wrap">
    <div class="section-head"><h2>{{ section.settings.heading }}</h2><a class="link" href="{{ more_url }}">View more</a></div>
    <div class="hscroll">
      {%- assign shown = 0 -%}
      {%- for product in items limit: section.settings.limit -%}
        {%- assign shown = shown | plus: 1 -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
      {%- if shown == 0 -%}{% render 'placeholder-cards', limit: section.settings.limit %}{%- endif -%}
      <a class="hscroll__more" href="{{ more_url }}"><span>{% render 'icon', name: 'arrow' %}</span>View more<small>All new arrivals</small></a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "New arrivals",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection (optional, otherwise newest products)" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 4, "max": 8, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "New arrivals" }]
}
{% endschema %}
