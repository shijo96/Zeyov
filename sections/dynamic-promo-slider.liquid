{%- comment -%}
  ZEYOV Dynamic Promotional Slider (Replacing Traditional Heavy Hero)
  - Desktop: 16:9 / 21:9 Sleek Panoramic Banner
  - Mobile: Compact ~4:3 / 2:1 Banner with high product density above the fold
{%- endcomment -%}

<section class="promo-slider-section" id="PromoSlider-{{ section.id }}" data-section-id="{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.autoplay_interval | default: 5000 }}">
  <div class="container container--wide">
    <div class="promo-slider" data-promo-slider>
      <div class="promo-slider__track" data-slider-track>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="promo-slide{% if forloop.first %} is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="promo-slide__media-wrap">
                {%- if block.settings.desktop_image != blank -%}
                  <picture>
                    {%- if block.settings.mobile_image != blank -%}
                      <source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image | image_url: width: 800 }}">
                    {%- endif -%}
                    <img src="{{ block.settings.desktop_image | image_url: width: 1600 }}" alt="{{ block.settings.heading | escape }}" width="1600" height="600" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" class="promo-slide__img">
                  </picture>
                {%- else -%}
                  <div class="promo-slide__fallback-bg promo-slide__fallback--{{ forloop.index | modulo: 3 }}">
                    <div class="promo-slide__overlay-pattern"></div>
                  </div>
                {%- endif -%}

                <div class="promo-slide__content-overlay">
                  <div class="promo-slide__content">
                    {%- if block.settings.badge != blank -%}
                      <span class="promo-slide__badge">{{ block.settings.badge }}</span>
                    {%- endif -%}
                    <h2 class="promo-slide__heading">{{ block.settings.heading | default: 'Runway Luxury, Crafted for Daily Wear.' }}</h2>
                    {%- if block.settings.subheading != blank -%}
                      <p class="promo-slide__subheading">{{ block.settings.subheading }}</p>
                    {%- endif -%}
                    <div class="promo-slide__actions">
                      {%- if block.settings.primary_button_link != blank -%}
                        <a href="{{ block.settings.primary_button_link }}" class="btn btn--gold promo-slide__btn">
                          {{ block.settings.primary_button_label | default: 'Shop Now' }}
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                      {%- endif -%}
                      {%- if block.settings.secondary_button_link != blank -%}
                        <a href="{{ block.settings.secondary_button_link }}" class="btn btn--outline-light promo-slide__btn">
                          {{ block.settings.secondary_button_label | default: 'Explore Drop' }}
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default High-Conversion Slide 1: Runway Capsule -->
          <div class="promo-slide is-active" data-slide-index="0">
            <div class="promo-slide__media-wrap">
              <picture>
                <source media="(max-width: 767px)" srcset="{{ 'collection-runway.jpg' | asset_url }}">
                <img src="{{ 'collection-runway.jpg' | asset_url }}" alt="ZEYOV SS25 Runway Edit" width="1600" height="600" loading="eager" class="promo-slide__img">
              </picture>
              <div class="promo-slide__content-overlay">
                <div class="promo-slide__content">
                  <span class="promo-slide__badge">SS25 RUNWAY CAPSULE</span>
                  <h2 class="promo-slide__heading">Draped To Sculpt.<br>Engineered To Move.</h2>
                  <p class="promo-slide__subheading">Pure mulberry silks, tailored co-ords, and modern luxury silhouettes.</p>
                  <div class="promo-slide__actions">
                    <a href="{{ routes.collections_url }}/womens-wear" class="btn btn--gold promo-slide__btn">
                      Explore Collection &rarr;
                    </a>
                    <a href="{{ routes.collections_url }}/womens-maxi-dresses" class="btn btn--outline-light promo-slide__btn">
                      Maxi Dresses
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Default High-Conversion Slide 2: Festive Celebration -->
          <div class="promo-slide" data-slide-index="1">
            <div class="promo-slide__media-wrap">
              <picture>
                <source media="(max-width: 767px)" srcset="{{ 'collection-festive.jpg' | asset_url }}">
                <img src="{{ 'collection-festive.jpg' | asset_url }}" alt="Festive Couture" width="1600" height="600" loading="lazy" class="promo-slide__img">
              </picture>
              <div class="promo-slide__content-overlay">
                <div class="promo-slide__content">
                  <span class="promo-slide__badge promo-slide__badge--sale">FESTIVE OFFER &bull; FLAT 10% OFF</span>
                  <h2 class="promo-slide__heading">Festive Atelier &amp; Royal Silks</h2>
                  <p class="promo-slide__subheading">Use code <strong>FESTIVE10</strong> at checkout &bull; Free Express Delivery across India</p>
                  <div class="promo-slide__actions">
                    <a href="{{ routes.collections_url }}/festive-collection" class="btn btn--gold promo-slide__btn">
                      Shop Festive Drop &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Default High-Conversion Slide 3: Kidswear & Baby -->
          <div class="promo-slide" data-slide-index="2">
            <div class="promo-slide__media-wrap">
              <picture>
                <source media="(max-width: 767px)" srcset="{{ 'collection-kidswear.jpg' | asset_url }}">
                <img src="{{ 'collection-kidswear.jpg' | asset_url }}" alt="Kidswear Atelier" width="1600" height="600" loading="lazy" class="promo-slide__img">
              </picture>
              <div class="promo-slide__content-overlay">
                <div class="promo-slide__content">
                  <span class="promo-slide__badge">LITTLE ATELIER</span>
                  <h2 class="promo-slide__heading">Cozy Flannel Rompers &amp; Gentle Kidswear</h2>
                  <p class="promo-slide__subheading">Crafted with breathable cotton and thermal plush lining for pure comfort.</p>
                  <div class="promo-slide__actions">
                    <a href="{{ routes.collections_url }}/kidswear" class="btn btn--gold promo-slide__btn">
                      Shop Kidswear &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Navigation Arrows -->
      <button type="button" class="promo-slider__arrow promo-slider__arrow--prev" data-slider-prev aria-label="Previous slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="promo-slider__arrow promo-slider__arrow--next" data-slider-next aria-label="Next slide">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <!-- Dots Indicators -->
      <div class="promo-slider__dots" data-slider-dots></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dynamic Promo Slider",
  "tag": "section",
  "class": "section-promo-slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Change slides every (ms)",
      "min": 3000,
      "max": 9000,
      "step": 1000,
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Promotional Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Image (Aspect ratio 16:9 or 21:9)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image (Compact ~4:3 or 2:1)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Text",
          "default": "NEW ARRIVAL"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Runway Luxury, Crafted for Daily Wear."
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Free shipping on prepaid orders across India."
        },
        {
          "type": "text",
          "id": "primary_button_label",
          "label": "Primary Button Label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "primary_button_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "secondary_button_label",
          "label": "Secondary Button Label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dynamic Promo Slider",
      "blocks": []
    }
  ]
}
{% endschema %}
