<section class="section">
  <div class="wrap">
    <div class="section-head"><div><span class="eyebrow">Collections</span><h2>{{ section.settings.heading }}</h2></div><a class="link" href="{{ routes.collections_url }}">View all</a></div>
    <div class="tiles">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="tile" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="tile__img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- elsif c.featured_image -%}
              {{ c.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: c.title }}
            {%- else -%}
              <img src="{{ block.settings.fallback | append: '.webp' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy" width="500" height="625">
            {%- endif -%}
          </div>
          <div><h3>{{ block.settings.title | default: c.title }}</h3><span>{{ block.settings.sub }}</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Collection tiles",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop by fit & fabric" }],
  "blocks": [{ "type": "tile", "name": "Tile", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "sub", "label": "Subtitle" },
    { "type": "select", "id": "fallback", "label": "Placeholder image", "default": "oversized-tee-250-gsm-french-terry-black", "options": [
      { "value": "oversized-tee-250-gsm-french-terry-black", "label": "Oversized black" },
      { "value": "oversized-tee-250-gsm-french-terry-beige", "label": "Oversized beige" },
      { "value": "oversized-tee-250-gsm-french-terry-lavender", "label": "Oversized lavender" },
      { "value": "acid-wash-oversized-tee-250-gsm-green", "label": "Acid wash" },
      { "value": "full-sleeve-oversized-tee-250-gsm-black", "label": "Full sleeve" },
      { "value": "oversized-tee-230-gsm-single-jersey-white", "label": "230 GSM white" },
      { "value": "oversized-tee-190-gsm-single-jersey-black", "label": "190 GSM black" },
      { "value": "regular-fit-tee-190-gsm-single-jersey-red", "label": "Regular red" }
    ] }
  ] }],
  "presets": [{ "name": "Collection tiles" }]
}
{% endschema %}
