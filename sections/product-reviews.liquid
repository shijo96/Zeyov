{%- comment -%}
  Product reviews.
  • If a review app block is added (recommended: Judge.me — photo reviews, star ratings,
    no login needed, review-request emails), the app's widget is shown and the theme's own
    form is hidden. Star ratings on cards and under the title read the app's standard
    reviews.rating / reviews.rating_count metafields, so the numbers always match.
  • Without an app, approved reviews come from the product metafield zeyov.reviews (JSON list):
    [{"name":"…","rating":5,"title":"…","body":"…","date":"12 Nov 2026","size":"L","verified":true,"photos":["https://…jpg"]}]
    and anyone can send a review with photos using the form below (no account needed).
{%- endcomment -%}
{%- assign app_block = false -%}
{%- for block in section.blocks -%}{%- if block.type == '@app' -%}{%- assign app_block = true -%}{%- endif -%}{%- endfor -%}

{%- assign list = product.metafields.zeyov.reviews.value -%}
{%- assign total = 0 -%}{%- assign sum = 0 -%}{%- assign photos = 0 -%}
{%- assign c5 = 0 -%}{%- assign c4 = 0 -%}{%- assign c3 = 0 -%}{%- assign c2 = 0 -%}{%- assign c1 = 0 -%}
{%- for r in list -%}
  {%- assign total = total | plus: 1 -%}{%- assign sum = sum | plus: r.rating -%}
  {%- if r.photos.size > 0 -%}{%- assign photos = photos | plus: 1 -%}{%- endif -%}
  {%- case r.rating -%}{%- when 5 -%}{%- assign c5 = c5 | plus: 1 -%}{%- when 4 -%}{%- assign c4 = c4 | plus: 1 -%}{%- when 3 -%}{%- assign c3 = c3 | plus: 1 -%}{%- when 2 -%}{%- assign c2 = c2 | plus: 1 -%}{%- else -%}{%- assign c1 = c1 | plus: 1 -%}{%- endcase -%}
{%- endfor -%}

<section class="section rv" id="Reviews">
  <div class="wrap">
    <div class="rv__head">
      <div><span class="eyebrow">Ratings &amp; reviews</span><h2>{{ section.settings.heading }}</h2></div>
      {%- unless app_block -%}<button type="button" class="btn btn--sm" data-rv-open aria-controls="RvForm-{{ section.id }}" aria-expanded="false">★ Write a review</button>{%- endunless -%}
    </div>

    {%- if app_block -%}
      <div class="rv__app">
        {%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}
      </div>
    {%- else -%}
      <div class="rv__grid">
        <aside class="rv__summary">
          {%- if total > 0 -%}
            {%- assign avg = sum | times: 1.0 | divided_by: total -%}
            <div class="rv__score">
              <b class="tabular">{{ avg | round: 1 }}</b>
              <div>
                <span class="stars"><span class="stars__row" style="--pct: {{ avg | times: 20 | round }}%"></span></span>
                <span class="muted">{{ total }} review{% if total != 1 %}s{% endif %}{% if photos > 0 %} · {{ photos }} with photos{% endif %}</span>
              </div>
            </div>
            <div class="bars">
              {%- assign counts = c5 | append: ',' | append: c4 | append: ',' | append: c3 | append: ',' | append: c2 | append: ',' | append: c1 | split: ',' -%}
              {%- for n in counts -%}
                {%- assign star = 6 | minus: forloop.index -%}
                {%- assign w = n | times: 100 | divided_by: total -%}
                <div><span>{{ star }} ★</span><i style="--w: {{ w }}%"></i><span class="tabular muted">{{ n }}</span></div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="rv__empty">
              <span class="stars"><span class="stars__row" style="--pct: 0%"></span></span>
              <b>No reviews yet</b>
              <p class="muted">Bought this tee? Be the first to share how it fits and feels.</p>
            </div>
          {%- endif -%}
        </aside>

        <div class="rv__list">
          {%- for r in list limit: section.settings.limit -%}
            <article class="rv__item">
              <div class="rv__top">
                <span class="stars"><span class="stars__row" style="--pct: {{ r.rating | times: 20 }}%"></span></span>
                {%- if r.date != blank -%}<span class="muted">{{ r.date }}</span>{%- endif -%}
              </div>
              {%- if r.title != blank -%}<h3>{{ r.title }}</h3>{%- endif -%}
              {%- if r.body != blank -%}<p>{{ r.body }}</p>{%- endif -%}
              {%- if r.photos.size > 0 -%}
                <div class="rv__photos">
                  {%- for ph in r.photos limit: 4 -%}
                    <a href="{{ ph }}" target="_blank" rel="noopener"><img src="{{ ph }}" alt="Photo from {{ r.name | escape }}" loading="lazy" width="96" height="96"></a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <div class="rv__by"><b>{{ r.name }}</b>{%- if r.verified -%}<span class="verified">✓ Verified buyer</span>{%- endif -%}{%- if r.size != blank -%}<span class="muted">Size: {{ r.size }}</span>{%- endif -%}</div>
            </article>
          {%- endfor -%}

          {%- form 'contact', id: 'ReviewForm', class: 'rv__form' -%}
            {%- if form.posted_successfully? -%}
              <p class="notice" data-rv-done>Thank you for your review! It will appear here once we've checked it.</p>
            {%- else -%}
              {%- if form.errors -%}<p class="notice notice--err">{{ form.errors | default_errors }}</p>{%- endif -%}
              <div id="RvForm-{{ section.id }}" class="rv__fields" data-rv-fields {% unless form.errors %}hidden{% endunless %}>
                <h3>Write a review</h3>
                <p class="muted">No account needed. Reviews are checked before they're published.</p>
                <input type="hidden" name="contact[Type]" value="Product review">
                <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}">
                <input type="hidden" name="contact[Product handle]" value="{{ product.handle }}">
                <fieldset class="form-row rv__rate">
                  <legend>Your rating</legend>
                  <div class="star-input" role="radiogroup" aria-label="Rating">
                    {%- for i in (1..5) -%}{%- assign s = 6 | minus: i -%}<input type="radio" id="rv-{{ section.id }}-{{ s }}" name="contact[Rating]" value="{{ s }} stars" {% if s == 5 %}checked{% endif %}><label for="rv-{{ section.id }}-{{ s }}" title="{{ s }} stars">★</label>{%- endfor -%}
                  </div>
                </fieldset>
                <div class="prebook__grid">
                  <label class="form-row"><span>Your name</span><input class="input" name="contact[name]" required autocomplete="name" value="{% if customer %}{{ customer.first_name }} {{ customer.last_name | slice: 0 }}.{% endif %}"></label>
                  <label class="form-row"><span>Email (not shown)</span><input class="input" type="email" name="contact[email]" required autocomplete="email" value="{% if customer %}{{ customer.email }}{% endif %}"></label>
                </div>
                <div class="prebook__grid">
                  <label class="form-row"><span>Size you bought</span><input class="input" name="contact[Size bought]" placeholder="e.g. L"></label>
                  <label class="form-row"><span>Order number (optional)</span><input class="input" name="contact[Order]" placeholder="#1001"></label>
                </div>
                <label class="form-row"><span>Title</span><input class="input" name="contact[Review title]" required maxlength="80" placeholder="Thick fabric, perfect fit"></label>
                <label class="form-row"><span>Your review</span><textarea class="input" name="contact[body]" required maxlength="1200" placeholder="How was the fit, fabric, print and delivery?"></textarea></label>
                {%- assign up = all_products['review-photo-upload'].selected_or_first_available_variant -%}
                {%- if up -%}
                  <div class="form-row rv__upload" data-rv-upload="{{ up.id }}">
                    <span>Add photos <small class="muted">(optional · up to 4)</small></span>
                    <label class="rv__drop">
                      <input type="file" accept="image/*" multiple data-rv-files>
                      <b>📷 Upload photos of your tee</b>
                      <small class="muted">JPG or PNG · tap to choose from your gallery</small>
                    </label>
                    <div class="rv__thumbs" data-rv-thumbs></div>
                  </div>
                {%- endif -%}
                <input type="hidden" name="contact[Photos]" data-rv-photos>
                <input type="hidden" name="contact[Review JSON]" data-rv-json>
                <p class="rv__status" data-rv-status aria-live="polite"></p>
                <button class="btn btn--block" type="submit" data-rv-submit>Submit review</button>
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
<script>
  (() => {
    const s = document.getElementById('Reviews'); if (!s) return;
    const btn = s.querySelector('[data-rv-open]'); const f = s.querySelector('[data-rv-fields]');
    if (btn && f) btn.addEventListener('click', () => { f.hidden = false; btn.setAttribute('aria-expanded', 'true'); f.scrollIntoView({ behavior: 'smooth', block: 'start' }); const i = f.querySelector('input[name="contact[name]"]'); i && setTimeout(() => i.focus(), 400); });
    if (s.querySelector('[data-rv-done]') || (f && !f.hidden)) s.scrollIntoView({ block: 'start' });

    const form = s.querySelector('form#ReviewForm'); if (!form) return;
    const box = form.querySelector('[data-rv-upload]'); const input = form.querySelector('[data-rv-files]');
    const thumbs = form.querySelector('[data-rv-thumbs]'); const status = form.querySelector('[data-rv-status]');
    const submit = form.querySelector('[data-rv-submit]'); let files = [];
    const MAX = 4;
    const draw = () => {
      thumbs.innerHTML = '';
      files.forEach((file, i) => {
        const fig = document.createElement('figure'); const img = document.createElement('img');
        img.src = URL.createObjectURL(file); img.alt = ''; fig.appendChild(img);
        const x = document.createElement('button'); x.type = 'button'; x.setAttribute('aria-label', 'Remove photo'); x.textContent = '×';
        x.addEventListener('click', () => { files.splice(i, 1); draw(); }); fig.appendChild(x); thumbs.appendChild(fig);
      });
    };
    input && input.addEventListener('change', () => {
      files = files.concat([...input.files].filter((x) => x.type.startsWith('image/'))).slice(0, MAX); input.value = ''; draw();
      if (files.length >= MAX) status.textContent = `Up to ${MAX} photos per review.`;
    });
    // shrink big phone photos before uploading (max 1600px, JPEG)
    const shrink = (file) => new Promise((ok) => {
      const img = new Image(); img.onload = () => {
        const k = Math.min(1, 1600 / Math.max(img.width, img.height));
        if (k === 1 && file.size < 1.5e6) return ok(file);
        const c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        c.toBlob((b) => ok(b ? new File([b], (file.name || 'photo').replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' }) : file), 'image/jpeg', 0.85);
      }; img.onerror = () => ok(file); img.src = URL.createObjectURL(file);
    });
    // Shopify stores files attached to a cart line; we add a hidden ₹0 line, read the photo links, then remove it.
    const upload = async () => {
      const fd = new FormData(); fd.append('id', box.dataset.rvUpload); fd.append('quantity', '1');
      const ready = await Promise.all(files.map(shrink));
      ready.forEach((file, i) => fd.append(`properties[Photo ${i + 1}]`, file));
      const r = await fetch('/cart/add.js', { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
      if (!r.ok) throw new Error('upload');
      const item = await r.json(); const line = item.items ? item.items[0] : item;
      const urls = Object.values(line.properties || {}).filter((v) => typeof v === 'string' && /\/\/|https?:/.test(v)).map((u) => (u.startsWith('//') ? 'https:' + u : u));
      await fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ id: line.key, quantity: 0 }) });
      return urls;
    };
    let sending = false;
    form.addEventListener('submit', async (e) => {
      if (sending) return; e.preventDefault();
      if (!form.reportValidity()) return;
      sending = true; submit.disabled = true; let urls = [];
      try {
        if (files.length && box) { status.textContent = `Uploading ${files.length} photo${files.length > 1 ? 's' : ''}…`; urls = await upload(); }
      } catch (err) { status.textContent = 'Photos could not be uploaded. Your review will be sent without them.'; }
      const v = (n) => (form.querySelector(`[name="contact[${n}]"]`) || {}).value || '';
      const rating = parseInt((form.querySelector('[name="contact[Rating]"]:checked') || {}).value, 10) || 5;
      const name = v('name').trim(); const parts = name.split(/\s+/);
      const shown = parts.length > 1 ? `${parts[0]} ${parts[parts.length - 1][0]}.` : name;
      const json = { name: shown, rating, title: v('Review title').trim(), body: v('body').trim(), date: new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }), size: v('Size bought').trim(), verified: false, photos: urls };
      form.querySelector('[data-rv-photos]').value = urls.join('\n');
      form.querySelector('[data-rv-json]').value = JSON.stringify(json);
      status.textContent = 'Sending your review…';
      HTMLFormElement.prototype.submit.call(form);
    });
  })();
</script>
{% schema %}
{
  "name": "Product reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What buyers say" },
    { "type": "range", "id": "limit", "label": "Reviews shown", "min": 4, "max": 40, "step": 2, "default": 12 },
    { "type": "paragraph", "content": "Reviews (with photos) arrive in your email. To publish one, open the product in Shopify admin → Metafields → Approved reviews, and paste the 'Review JSON' line from the email into the [ ] list." }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
