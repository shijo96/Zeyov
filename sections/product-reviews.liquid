{%- assign list = product.metafields.zeyov.reviews.value -%}
{%- assign total = 0 -%}{%- assign sum = 0 -%}
{%- assign c5 = 0 -%}{%- assign c4 = 0 -%}{%- assign c3 = 0 -%}{%- assign c2 = 0 -%}{%- assign c1 = 0 -%}
{%- for r in list -%}
  {%- assign total = total | plus: 1 -%}{%- assign sum = sum | plus: r.rating -%}
  {%- case r.rating -%}{%- when 5 -%}{%- assign c5 = c5 | plus: 1 -%}{%- when 4 -%}{%- assign c4 = c4 | plus: 1 -%}{%- when 3 -%}{%- assign c3 = c3 | plus: 1 -%}{%- when 2 -%}{%- assign c2 = c2 | plus: 1 -%}{%- else -%}{%- assign c1 = c1 | plus: 1 -%}{%- endcase -%}
{%- endfor -%}
<section class="section" id="Reviews" style="border-top:1px solid var(--line)">
  <div class="wrap reviews" data-reviews data-handle="{{ product.handle }}">
    <div class="reviews__aside">
      <div><span class="eyebrow">Ratings &amp; reviews</span><h2 style="font-size:clamp(26px,5vw,38px);margin-top:6px">{{ section.settings.heading }}</h2></div>
      <div class="reviews__summary">
        {%- if total > 0 -%}
          {%- assign avg = sum | times: 1.0 | divided_by: total -%}
          <div class="reviews__score"><b class="tabular">{{ avg | round: 1 }}</b><div><span class="stars"><span class="stars__row" style="--pct: {{ avg | times: 20 | round }}%"></span></span><div class="muted" style="font-size:13px">Based on {{ total }} review{% if total != 1 %}s{% endif %}</div></div></div>
          <div class="bars">
            {%- assign counts = c5 | append: ',' | append: c4 | append: ',' | append: c3 | append: ',' | append: c2 | append: ',' | append: c1 | split: ',' -%}
            {%- for n in counts -%}
              {%- assign star = 6 | minus: forloop.index -%}
              {%- assign w = n | times: 100 | divided_by: total -%}
              <div><span>{{ star }} ★</span><i style="--w: {{ w }}%"></i><span class="tabular muted">{{ n }}</span></div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <p>No reviews yet. Reviews come only from customers who bought this product.</p>
        {%- endif -%}
        <a href="/pages/orders" class="btn btn--outline-gold btn--block">Review from My Orders</a>
      </div>
      {%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}
    </div>

    <div>
      {%- for r in list limit: 20 -%}
        <article class="review">
          <div class="review__top"><span class="stars"><span class="stars__row" style="--pct: {{ r.rating | times: 20 }}%"></span></span><span class="muted">{{ r.date }}</span></div>
          {%- if r.title != blank -%}<h4>{{ r.title }}</h4>{%- endif -%}
          <p>{{ r.body }}</p>
          <div style="display:flex;gap:10px;align-items:center;font-size:13px"><b>{{ r.name }}</b>{%- if r.verified -%}<span class="verified">✓ Verified buyer</span>{%- endif -%}{%- if r.size != blank -%}<span class="muted">Size bought: {{ r.size }}</span>{%- endif -%}</div>
        </article>
      {%- endfor -%}

      <div class="review-cta" style="margin-top:20px">
        <b>Only verified buyers can review</b>
        <span class="muted">Bought this {{ product.title }}? Write your review from My Orders once it's shipped.</span>
        <a class="btn btn--sm btn--outline-gold" style="justify-self:start" href="/pages/orders">Go to My Orders</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Product reviews",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "What buyers say" }],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
