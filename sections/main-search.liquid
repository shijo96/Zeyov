{%- paginate search.results by 24 -%}
<div class="wrap" data-facet-root data-section-id="{{ section.id }}">
  <div class="coll-hero">
    <span class="eyebrow">Search</span>
    <h1>{% if search.performed %}“{{ search.terms }}”{% else %}Search the store{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" class="field-inline" role="search" style="max-width:560px;margin-top:8px" data-search-page-form>
      <input type="hidden" name="type" value="product">
      <label for="SearchPageInput" class="visually-hidden">Search</label>
      <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Name, colour, GSM or ‘under 700’">
      <button class="btn btn--sm" type="submit">Search</button>
    </form>
  </div>
  {%- if search.performed -%}
  <div class="toolbar">
    <button type="button" class="toolbar__btn js-open-filters" data-open-filters>{% render 'icon', name: 'filter' %}Filter</button>
    <span class="toolbar__count tabular" data-facet-count>{{ search.results_count }} results</span>
    {% render 'sort-select', results: search, search_mode: true %}
  </div>
  <div class="coll-layout">
    <div data-facet-filters>{% render 'facets', results: search, url: routes.search_url, section_id: section.id, terms: search.terms %}</div>
    <div class="results" data-facet-results>
      {% render 'active-chips', results: search, url: routes.search_url, terms: search.terms %}
      {%- if search.results_count > 0 -%}
        <div class="grid">
          {%- for item in search.results -%}{%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}{%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- else -%}
        <div class="empty"><h2>Nothing found for “{{ search.terms }}”</h2><p class="muted">Try a colour like “black”, a fit like “oversized”, or a price like “under 800”.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Shop all tees</a></div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}
</div>
{%- endpaginate -%}
{% schema %}
{ "name": "Search results" }
{% endschema %}
