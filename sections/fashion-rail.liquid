<section class="fashion-rail-section" id="RunwayRail">
  <div class="container">
    <div class="fashion-rail__header">
      <div>
        <span class="fashion-rail__tag">{{ section.settings.eyebrow | default: 'THE RUNWAY LOOKBOOK' }}</span>
        <h2 class="fashion-rail__title">{{ section.settings.heading | default: 'CURATED SILHOUETTES' }}</h2>
      </div>
      <div class="fashion-rail__header-actions">
        <p class="fashion-rail__desc">{{ section.settings.subheading | default: 'Every piece is precision-tailored in limited batches with luxury fabrics designed for lasting distinction.' }}</p>
        <div class="fashion-rail__nav-arrows">
          <button type="button" class="rail-arrow prev" data-rail-prev-look aria-label="Previous look">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="rail-arrow next" data-rail-next-look aria-label="Next look">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>

    {%- comment -%}
      Determine Lookbook Mode:
      1. Blocks (Custom Look blocks with product and image pickers)
      2. Product settings (settings.product_1..4)
      3. Collection (settings.collection or collections.all)
      4. Fallback defaults
    {%- endcomment -%}
    {%- assign rail_mode = 'demo' -%}
    {%- if section.blocks.size > 0 -%}
      {%- assign rail_mode = 'blocks' -%}
    {%- elsif section.settings.product_1 != blank or section.settings.product_2 != blank or section.settings.product_3 != blank or section.settings.product_4 != blank -%}
      {%- assign rail_mode = 'products' -%}
    {%- else -%}
      {%- assign rail_col = section.settings.collection | default: collections.all -%}
      {%- if rail_col.products.size > 0 -%}
        {%- assign rail_mode = 'collection' -%}
      {%- endif -%}
    {%- endif -%}

    <!-- Drag / Scroll Lookbook Rail -->
    <div class="fashion-rail__viewport" id="LookbookRailViewport">
      <div class="fashion-rail__track" data-horizontal-rail>
        {%- if rail_mode == 'blocks' -%}
          {%- for block in section.blocks limit: 8 -%}
            {%- assign p = block.settings.product -%}
            {%- assign t = block.settings.title | default: p.title | default: 'Runway Look' -%}
            {%- assign pr = p.price | money | default: 'Rs. 3,499.00' -%}
            {%- assign url = p.url | default: routes.all_products_collection_url -%}
            {%- assign tag = block.settings.category | default: p.type | default: 'ATELIER LOOK' | upcase -%}
            {%- assign fab = block.settings.fabric | default: p.description | strip_html | truncate: 75 | default: 'Master-tailored with premium natural fibers' -%}
            {%- if block.settings.image != blank -%}
              {%- assign img_src = block.settings.image | image_url: width: 700 -%}
            {%- elsif p.featured_image != blank -%}
              {%- assign img_src = p.featured_image | image_url: width: 700 -%}
            {%- else -%}
              {%- assign img_src = 'fashion-silk-dress.jpg' | asset_url -%}
            {%- endif -%}

            <div class="fashion-rail__slide" {{ block.shopify_attributes }}>
              <div class="look-card" data-product-url="{{ url }}">
                <a href="{{ url }}" class="look-card__media" aria-label="{{ t | escape }}">
                  <img src="{{ img_src }}" alt="{{ t | escape }}" width="400" height="400" loading="lazy">
                  <span class="look-card__number">LOOK {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="look-card__quick-tag">Shop Piece &rarr;</span>
                </a>
                <div class="look-card__details">
                  <span class="look-card__category">{{ tag }}</span>
                  <h3 class="look-card__name"><a href="{{ url }}">{{ t }}</a></h3>
                  <p class="look-card__fabric">{{ fab }}</p>
                  <div class="look-card__foot">
                    <span class="look-card__price">{{ pr }}</span>
                    <a href="{{ url }}" class="look-card__link">Shop Look &rarr;</a>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}

        {%- elsif rail_mode == 'products' -%}
          {%- assign shown_cnt = 0 -%}
          {%- for i in (1..4) -%}
            {%- assign p_key = 'product_' | append: i -%}
            {%- assign img_key = 'image_' | append: i -%}
            {%- assign tag_key = 'tag_' | append: i -%}
            {%- assign fab_key = 'fabric_' | append: i -%}
            {%- assign p = section.settings[p_key] -%}
            {%- if p != blank -%}
              {%- assign shown_cnt = shown_cnt | plus: 1 -%}
              {%- assign t = p.title -%}
              {%- assign pr = p.price | money -%}
              {%- assign url = p.url -%}
              {%- assign tag = section.settings[tag_key] | default: p.type | default: 'ATELIER LOOK' | upcase -%}
              {%- assign fab = section.settings[fab_key] | default: p.description | strip_html | truncate: 75 | default: 'Precision-tailored in limited batches' -%}
              {%- if section.settings[img_key] != blank -%}
                {%- assign img_src = section.settings[img_key] | image_url: width: 700 -%}
              {%- elsif p.featured_image != blank -%}
                {%- assign img_src = p.featured_image | image_url: width: 700 -%}
              {%- else -%}
                {%- assign img_src = 'fashion-silk-dress.jpg' | asset_url -%}
              {%- endif -%}

              <div class="fashion-rail__slide">
                <div class="look-card" data-product-url="{{ url }}">
                  <a href="{{ url }}" class="look-card__media" aria-label="{{ t | escape }}">
                    <img src="{{ img_src }}" alt="{{ t | escape }}" width="400" height="400" loading="lazy">
                    <span class="look-card__number">LOOK {{ shown_cnt | prepend: '0' | slice: -2, 2 }}</span>
                    <span class="look-card__quick-tag">Shop Piece &rarr;</span>
                  </a>
                  <div class="look-card__details">
                    <span class="look-card__category">{{ tag }}</span>
                    <h3 class="look-card__name"><a href="{{ url }}">{{ t }}</a></h3>
                    <p class="look-card__fabric">{{ fab }}</p>
                    <div class="look-card__foot">
                      <span class="look-card__price">{{ pr }}</span>
                      <a href="{{ url }}" class="look-card__link">Shop Look &rarr;</a>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

        {%- elsif rail_mode == 'collection' -%}
          {%- for p in rail_col.products limit: 6 -%}
            {%- assign t = p.title -%}
            {%- assign pr = p.price | money -%}
            {%- assign url = p.url -%}
            {%- assign tag = p.type | default: 'RUNWAY LOOK' | upcase -%}
            {%- assign fab = p.description | strip_html | truncate: 75 | default: 'Precision-tailored with premium natural fibers' -%}
            {%- if p.featured_image != blank -%}
              {%- assign img_src = p.featured_image | image_url: width: 700 -%}
            {%- else -%}
              {%- assign img_src = 'fashion-silk-dress.jpg' | asset_url -%}
            {%- endif -%}

            <div class="fashion-rail__slide">
              <div class="look-card" data-product-url="{{ url }}">
                <a href="{{ url }}" class="look-card__media" aria-label="{{ t | escape }}">
                  <img src="{{ img_src }}" alt="{{ t | escape }}" width="400" height="400" loading="lazy">
                  <span class="look-card__number">LOOK {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="look-card__quick-tag">Shop Piece &rarr;</span>
                </a>
                <div class="look-card__details">
                  <span class="look-card__category">{{ tag }}</span>
                  <h3 class="look-card__name"><a href="{{ url }}">{{ t }}</a></h3>
                  <p class="look-card__fabric">{{ fab }}</p>
                  <div class="look-card__foot">
                    <span class="look-card__price">{{ pr }}</span>
                    <a href="{{ url }}" class="look-card__link">Shop Look &rarr;</a>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}

        {%- else -%}
          <!-- Starter Luxury Defaults -->
          <div class="fashion-rail__slide">
            <div class="look-card" data-product-url="{{ routes.all_products_collection_url }}">
              <a href="{{ routes.all_products_collection_url }}" class="look-card__media" aria-label="Emerald Draped Silk Gown">
                <img src="{{ 'fashion-silk-dress.jpg' | asset_url }}" alt="Emerald Silk Evening Gown" width="400" height="400" loading="lazy">
                <span class="look-card__number">LOOK 01</span>
                <span class="look-card__quick-tag">Shop Piece &rarr;</span>
              </a>
              <div class="look-card__details">
                <span class="look-card__category">EVENING &amp; OCCASION</span>
                <h3 class="look-card__name"><a href="{{ routes.all_products_collection_url }}">Emerald Draped Silk Gown</a></h3>
                <p class="look-card__fabric">100% Grade-6A Mulberry Silk &bull; Hand-stitched Grecian drape</p>
                <div class="look-card__foot">
                  <span class="look-card__price">Rs. 3,899.00</span>
                  <a href="{{ routes.all_products_collection_url }}" class="look-card__link">Shop Look &rarr;</a>
                </div>
              </div>
            </div>
          </div>

          <div class="fashion-rail__slide">
            <div class="look-card" data-product-url="{{ routes.all_products_collection_url }}">
              <a href="{{ routes.all_products_collection_url }}" class="look-card__media" aria-label="Camel Double-Breasted Trench">
                <img src="{{ 'fashion-wool-coat.jpg' | asset_url }}" alt="Camel Tailored Wool Trench" width="400" height="400" loading="lazy">
                <span class="look-card__number">LOOK 02</span>
                <span class="look-card__quick-tag">Shop Piece &rarr;</span>
              </a>
              <div class="look-card__details">
                <span class="look-card__category">OUTERWEAR ATELIER</span>
                <h3 class="look-card__name"><a href="{{ routes.all_products_collection_url }}">Camel Double-Breasted Trench</a></h3>
                <p class="look-card__fabric">Double-Faced Virgin Wool &bull; Custom Horn Buttons</p>
                <div class="look-card__foot">
                  <span class="look-card__price">Rs. 4,299.00</span>
                  <a href="{{ routes.all_products_collection_url }}" class="look-card__link">Shop Look &rarr;</a>
                </div>
              </div>
            </div>
          </div>

          <div class="fashion-rail__slide">
            <div class="look-card" data-product-url="{{ routes.all_products_collection_url }}">
              <a href="{{ routes.all_products_collection_url }}" class="look-card__media" aria-label="Amber Thermal Air-Loft Vest">
                <img src="{{ 'fashion-puffer-jacket.jpg' | asset_url }}" alt="Amber Thermal Loft Puffer" width="400" height="400" loading="lazy">
                <span class="look-card__number">LOOK 03</span>
                <span class="look-card__quick-tag">Shop Piece &rarr;</span>
              </a>
              <div class="look-card__details">
                <span class="look-card__category">WINTER CAPSULE</span>
                <h3 class="look-card__name"><a href="{{ routes.all_products_collection_url }}">Amber Thermal Air-Loft Vest</a></h3>
                <p class="look-card__fabric">Water-repellent micro-ripstop shell &bull; 700 Fill-power loft</p>
                <div class="look-card__foot">
                  <span class="look-card__price">Rs. 2,499.00</span>
                  <a href="{{ routes.all_products_collection_url }}" class="look-card__link">Shop Look &rarr;</a>
                </div>
              </div>
            </div>
          </div>

          <div class="fashion-rail__slide">
            <div class="look-card" data-product-url="{{ routes.all_products_collection_url }}">
              <a href="{{ routes.all_products_collection_url }}" class="look-card__media" aria-label="Cream Sherpa Half-Zip Pullover">
                <img src="{{ 'fashion-sherpa-jacket.jpg' | asset_url }}" alt="Cream Bonded Sherpa Fleece" width="400" height="400" loading="lazy">
                <span class="look-card__number">LOOK 04</span>
                <span class="look-card__quick-tag">Shop Piece &rarr;</span>
              </a>
              <div class="look-card__details">
                <span class="look-card__category">COMFORT LUXURY</span>
                <h3 class="look-card__name"><a href="{{ routes.all_products_collection_url }}">Cream Sherpa Half-Zip Pullover</a></h3>
                <p class="look-card__fabric">Bonded High-Density Sherpa &bull; Navy twill contrast chest flap</p>
                <div class="look-card__foot">
                  <span class="look-card__price">Rs. 2,899.00</span>
                  <a href="{{ routes.all_products_collection_url }}" class="look-card__link">Shop Look &rarr;</a>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fashion Lookbook Rail",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow tag", "default": "THE RUNWAY LOOKBOOK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CURATED SILHOUETTES" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every piece is precision-tailored in limited batches with luxury fabrics designed for lasting distinction." },
    { "type": "collection", "id": "collection", "label": "Lookbook Collection", "info": "Automatically pull looks from this collection" },
    { "type": "header", "content": "Individual Looks (Overrides Collection)" },
    { "type": "product", "id": "product_1", "label": "Product for Look 01" },
    { "type": "image_picker", "id": "image_1", "label": "Look 01 Custom Photo (optional)" },
    { "type": "text", "id": "tag_1", "label": "Look 01 Category Tag", "default": "EVENING & OCCASION" },
    { "type": "text", "id": "fabric_1", "label": "Look 01 Fabric Note", "default": "100% Grade-6A Mulberry Silk • Hand-stitched drape" },
    { "type": "product", "id": "product_2", "label": "Product for Look 02" },
    { "type": "image_picker", "id": "image_2", "label": "Look 02 Custom Photo (optional)" },
    { "type": "text", "id": "tag_2", "label": "Look 02 Category Tag", "default": "OUTERWEAR ATELIER" },
    { "type": "text", "id": "fabric_2", "label": "Look 02 Fabric Note", "default": "Double-Faced Virgin Wool • Custom Horn Buttons" },
    { "type": "product", "id": "product_3", "label": "Product for Look 03" },
    { "type": "image_picker", "id": "image_3", "label": "Look 03 Custom Photo (optional)" },
    { "type": "text", "id": "tag_3", "label": "Look 03 Category Tag", "default": "WINTER CAPSULE" },
    { "type": "text", "id": "fabric_3", "label": "Look 03 Fabric Note", "default": "Water-repellent micro-ripstop shell • 700 Fill loft" },
    { "type": "product", "id": "product_4", "label": "Product for Look 04" },
    { "type": "image_picker", "id": "image_4", "label": "Look 04 Custom Photo (optional)" },
    { "type": "text", "id": "tag_4", "label": "Look 04 Category Tag", "default": "COMFORT LUXURY" },
    { "type": "text", "id": "fabric_4", "label": "Look 04 Fabric Note", "default": "Bonded High-Density Sherpa • Navy contrast flap" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Lookbook Slide",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Custom Look Photo (optional)" },
        { "type": "text", "id": "title", "label": "Custom Title Override (optional)" },
        { "type": "text", "id": "category", "label": "Category Tag", "default": "RUNWAY LOOK" },
        { "type": "text", "id": "fabric", "label": "Fabric / Craft Note" }
      ]
    }
  ],
  "presets": [{ "name": "Fashion Lookbook Rail" }]
}
{% endschema %}
