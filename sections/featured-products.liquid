{%- assign c = section.settings.collection -%}
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div>
      <a class="link" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">Shop all</a>
    </div>
    <div class="grid grid--4">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}{% render 'product-card', product: product, collection: c %}{%- endfor -%}
      {%- elsif collections.all.products_count > 0 -%}
        {%- for product in collections.all.products limit: section.settings.limit -%}{% render 'product-card', product: product %}{%- endfor -%}
      {%- else -%}
        {% render 'placeholder-cards', limit: section.settings.limit %}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most loved tees" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 2, "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
