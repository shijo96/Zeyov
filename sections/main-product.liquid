{%- assign v = product.selected_or_first_available_variant -%}
{%- assign color_index = -1 -%}{%- assign size_index = -1 -%}
{%- for o in product.options_with_values -%}
  {%- assign on = o.name | downcase -%}
  {%- if on contains 'colo' -%}{%- assign color_index = forloop.index0 -%}{%- endif -%}
  {%- if on contains 'size' -%}{%- assign size_index = forloop.index0 -%}{%- endif -%}
{%- endfor -%}
<div class="wrap" data-product data-handle="{{ product.handle }}" data-product-id="{{ product.id }}" data-color-index="{{ color_index }}" data-size-index="{{ size_index }}">
  <script type="application/json" data-product-json>
    {"id":{{ product.id }},"title":{{ product.title | json }},"handle":{{ product.handle | json }},"image":{{ product.featured_media | image_url: width: 200 | json }},
     "options":{{ product.options | json }},
     "variants":[{%- for x in product.variants -%}{"id":{{ x.id }},"options":{{ x.options | json }},"price":{{ x.price }},"compare":{{ x.compare_at_price | default: 0 }},"available":{{ x.available }},"media":{{ x.featured_media.id | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
  </script>
  <div class="pdp">
    <div class="gallery">
      <div class="gallery__thumbs" data-thumbs>
        {%- for m in product.media -%}
          <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-thumb="{{ forloop.index0 }}" data-media-id="{{ m.id }}" aria-label="Show image {{ forloop.index }}">
            {{ m.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        {%- endfor -%}
      </div>
      <div class="gallery__main">
        <div class="gallery__track" data-track>
          {%- for m in product.media -%}
            <div class="gallery__slide" data-media-id="{{ m.id }}">
              {%- if m.media_type == 'video' or m.media_type == 'external_video' -%}
                {{ m | media_tag: image_size: '1200x' }}
              {%- else -%}
                {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
                {{ m.preview_image | image_url: width: 1400 | image_tag: loading: ld, widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: m.alt | default: product.title }}
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="gallery__slide">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
          {%- endfor -%}
        </div>
        {%- if product.media.size > 1 -%}<div class="gallery__dots" data-dots>{%- for m in product.media -%}<i class="{% if forloop.first %}is-active{% endif %}"></i>{%- endfor -%}</div>{%- endif -%}
        <button type="button" class="share" data-share="{{ shop.url }}{{ product.url }}" data-share-title="{{ product.title | escape }}" aria-label="Share">{% render 'icon', name: 'share' %}</button>
        <button type="button" class="heart" data-wish="{{ product.handle }}" aria-label="Save to wishlist" aria-pressed="false"><svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.4-7.5-10.1A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.6C19.5 15.6 12 20 12 20z"/></svg></button>
      </div>
    </div>

    <div class="info">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a> / {% endif %}<span>{{ product.title }}</span></nav>
      <div style="display:grid;gap:8px">
        {%- if product.type != blank -%}<span class="eyebrow">{{ product.type }}</span>{%- endif -%}
        <h1>{{ product.title }}</h1>
        <a href="#Reviews">{% render 'rating', product: product %}</a>
      </div>
      <div>
        <div class="info__price" data-main-price>
          <span class="price__now">{{ v.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</span>
          {%- if v.compare_at_price > v.price -%}<s class="price__was">{{ v.compare_at_price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</s><span class="save-badge">-{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}%</span>{%- endif -%}
        </div>
        <p class="tax-note">Inclusive of all taxes · {{ settings.free_shipping_text }}</p>
      </div>
      {%- if product.metafields.zeyov.fabric != blank or product.tags.size > 0 -%}
        <div class="spec-chips">
          {%- if product.metafields.zeyov.fabric != blank -%}<span>{{ product.metafields.zeyov.fabric }}</span>{%- endif -%}
          {%- for t in product.tags -%}{%- if t contains 'GSM' or t contains 'Fit' or t contains 'fit' -%}<span>{{ t }}</span>{%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}

      {%- for o in product.options_with_values -%}
        {%- assign on = o.name | downcase -%}
        {%- if forloop.index0 == color_index -%}
          <div class="opt">
            <div class="opt__label"><span><b>Select Color</b> · <span data-opt-label="{{ forloop.index0 }}">{{ o.selected_value }}</span></span></div>
            <div class="colors" role="radiogroup" aria-label="{{ o.name }}">
              {%- for val in o.values -%}
                <button type="button" class="color-btn {% if val == o.selected_value %}is-active{% endif %}" role="radio" aria-checked="{% if val == o.selected_value %}true{% else %}false{% endif %}" data-opt="{{ forloop.parentloop.index0 }}" data-value="{{ val | escape }}" title="{{ val | escape }}" aria-label="{{ val | escape }}" style="background: {% render 'swatch-hex', name: val %}"></button>
              {%- endfor -%}
            </div>
          </div>
        {%- elsif o.name != 'Title' -%}
          <div class="opt">
            <div class="opt__label"><span><b>Select {{ o.name }}</b> · <span data-opt-label="{{ forloop.index0 }}">{{ o.selected_value }}</span></span>{%- if forloop.index0 == size_index -%}<button type="button" data-open-modal="SizeChart">Size chart</button>{%- endif -%}</div>
            <div class="sizes" role="radiogroup" aria-label="{{ o.name }}">
              {%- for val in o.values -%}
                {%- capture vs -%}{{ val }}{%- endcapture -%}<button type="button" class="size-btn {% if vs.size > 4 %}size-btn--long{% endif %} {% if val == o.selected_value %}is-active{% endif %}" role="radio" aria-checked="{% if val == o.selected_value %}true{% else %}false{% endif %}" data-opt="{{ forloop.parentloop.index0 }}" data-value="{{ val | escape }}">{{ val }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="bundlebox" data-bundles>
        <h3>Bundle Offer</h3>
        {%- assign p2 = settings.bundle2_pct | default: 5 -%}{%- assign p3 = settings.bundle3_pct | default: 10 -%}
        {%- for q in (1..3) -%}
          {%- if q == 1 -%}{%- assign pct = 0 -%}{%- elsif q == 2 -%}{%- assign pct = p2 -%}{%- else -%}{%- assign pct = p3 -%}{%- endif -%}
          {%- assign full = v.price | times: q -%}
          {%- assign deal = 100 | minus: pct | times: full | divided_by: 100 -%}
          <label class="brow">
            <input type="radio" name="bundle-qty" value="{{ q }}" data-pct="{{ pct }}" {% if q == 1 %}checked{% endif %}>
            <span>{{ q }} Piece{% if q > 1 %}s{% endif %} – {% if pct > 0 %}<em>Extra {{ pct }}% OFF</em>{% else %}<span data-bundle-one>{{ v.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</span> <span class="muted">(Actual Price)</span>{% endif %}</span>
            <b data-bundle-price>{% if pct > 0 %}{{ deal | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}{% endif %}</b>
          </label>
        {%- endfor -%}
      </div>

      <form action="{{ routes.cart_add_url }}" method="post" data-product-form>
        <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>
        <input type="hidden" name="quantity" value="1" data-qty>
        <div class="buy" data-buy>
          <button type="submit" class="btn" data-atc {% unless v.available %}disabled{% endunless %}>{% render 'icon', name: 'cart' %}<span data-atc-text>{% if v.available %}Add to Cart{% else %}Sold out{% endif %}</span></button>
          <button type="button" class="heart-lg" data-wish="{{ product.handle }}" aria-label="Save to wishlist" aria-pressed="false"><svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.4-7.5-10.1A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.6C19.5 15.6 12 20 12 20z"/></svg></button>
          <button type="button" class="btn btn--dark" data-buy-now {% unless v.available %}disabled{% endunless %}>Buy it now</button>
        </div>
      </form>
      <p class="muted" style="font-size:13px">Cart offer: {{ settings.tier1_qty }}+ items = extra {{ settings.tier1_pct }}% off · {{ settings.tier2_qty }}+ items = extra {{ settings.tier2_pct }}% off.</p>

      <div class="perks">
        <div>{% render 'icon', name: 'truck' %}Free delivery (online pay)</div>
        <div>{% render 'icon', name: 'cod' %}COD +₹{{ settings.cod_fee | default: 80 }}</div>
        <div>{% render 'icon', name: 'return' %}7-day replace</div>
      </div>

      <div class="acc">
        <details open><summary>Description{% render 'icon', name: 'chev' %}</summary><div class="rte">{{ product.description | default: '<p>Our own-brand tee, cut and finished in-house.</p>' }}</div></details>
        <details><summary>Fabric &amp; fit{% render 'icon', name: 'chev' %}</summary><div class="rte">
          {%- if product.metafields.zeyov.fabric_details != blank -%}{{ product.metafields.zeyov.fabric_details | metafield_tag }}{%- else -%}
          <ul><li>100% combed cotton, bio-washed for a soft hand-feel</li><li>Rib collar with double-needle stitched hems</li><li>Oversized: drop shoulder, boxy body. Take your usual size for the oversized look, one size down for a relaxed fit.</li><li>Wash cold inside out, dry in shade, do not iron on print</li></ul>{%- endif -%}
        </div></details>
        <details><summary>Shipping &amp; replacement{% render 'icon', name: 'chev' %}</summary><div class="rte"><p>Dispatched in 24–48 hours. Delivery in 3–7 days across India. Free delivery on online payment; cash on delivery available for ₹{{ settings.cod_fee | default: 80 }} extra. 7-day replace: if your item arrives damaged, defective or in the wrong size, we replace it within 7 days of delivery.</p></div></details>
      </div>
      {%- for block in section.blocks -%}{%- case block.type -%}{%- when '@app' -%}{% render block %}{%- endcase -%}{%- endfor -%}
    </div>
  </div>

  <div class="sticky-atc" data-sticky-atc aria-hidden="true">
    <div class="sticky-atc__inner" style="display:flex;align-items:center;gap:12px;width:100%">
      {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
      <div class="sticky-atc__t"><div>{{ product.title }}</div><b data-sticky-price>{{ v.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</b> <span class="muted" data-sticky-variant>{{ v.title }}</span></div>
      <button type="button" class="btn" data-sticky-btn>Add to Cart</button>
    </div>
  </div>

  <div class="modal" id="SizeChart" hidden role="dialog" aria-modal="true" aria-labelledby="SizeChartTitle">
    <div class="scrim" data-close-modal></div>
    <div class="modal__panel">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px"><h2 id="SizeChartTitle" style="font-size:24px">Size chart (inches)</h2><button class="icon-btn" data-close-modal aria-label="Close">{% render 'icon', name: 'close' %}</button></div>
      {%- if settings.size_chart_page != blank -%}<div class="rte">{{ settings.size_chart_page.content }}</div>{%- else -%}
      <div class="table-wrap"><table class="size-table">
        <thead><tr><th>Size</th><th>Oversized chest</th><th>Oversized length</th><th>Regular chest</th><th>Regular length</th></tr></thead>
        <tbody>
          <tr><td>S</td><td>42</td><td>28</td><td>38</td><td>27</td></tr>
          <tr><td>M</td><td>44</td><td>29</td><td>40</td><td>28</td></tr>
          <tr><td>L</td><td>46</td><td>30</td><td>42</td><td>29</td></tr>
          <tr><td>XL</td><td>48</td><td>31</td><td>44</td><td>30</td></tr>
          <tr><td>XXL</td><td>50</td><td>32</td><td>46</td><td>31</td></tr>
        </tbody>
      </table></div>
      <p class="muted" style="font-size:13px;margin-top:12px">Measured flat, garment measurements ±0.5". Between sizes? Size up for oversized drape.</p>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Product",
  "blocks": [{ "type": "@app" }],
  "settings": []
}
{% endschema %}
